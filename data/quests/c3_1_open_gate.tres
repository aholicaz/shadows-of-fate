[resource]
script = ExtResource("1_quest")
id = &"c3_1_open_gate"
title = "C3-1 ประตูที่เปิดค้างไว้"
description = "ทำความรู้จักผู้คนในวานาเฮม — ทหารยาม แม่ค้า และนักบันทึกจากวิหาร"
giver_name = "ผู้อาวุโสญอร์ดา"
dialog_offer = "คนแคระส่งเจ้ามาสินะ... ประตูนครนี้เปิดค้างมาสามร้อยปี ไม่มีใครมา ไม่มีใครไป ไปทักทายผู้คนก่อนเถอะ — ยามอาร์วิด แม่ค้าซิฟา และ... นักบันทึกจากวิหารที่มาอยู่กับเราสองปีแล้ว"
dialog_progress = "อาร์วิดอยู่หน้าประตูตะวันออก ซิฟาอยู่กลางตลาด ส่วนเอสกิล... แกอยู่ตรงที่มองเห็นทุกคน"
dialog_complete = "เจ้าคุยกับเอสกิลแล้ว... แกบอกไหมว่าใครส่งแกมา ไม่บอกสินะ นี่ตราวานีร์ ถือไว้ นครนี้จะถือว่าเจ้าเป็นแขก ไม่ใช่ทหาร"
objectives = Array[ExtResource("2_obj")]([SubResource("Obj_0"), SubResource("Obj_1"), SubResource("Obj_2")])
kill_monster_id = &""
required_level = 38
required_flag = &"chapter2_done"
set_flag_on_complete = &"vanir_intro"
reward_item_id = &"vanir_seal"
reward_item_count = 1
reward_zeny = 3000
reward_exp = 6000
