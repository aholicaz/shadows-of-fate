[resource]
script = ExtResource("1_quest")
id = &"c3_2_roots_in_town"
title = "รากที่เลื้อยเข้าเมือง"
description = "รากเลื้อยกับหมาป่าหนามล้นมาถึงกำแพงเมือง ไปจัดการพวกมันบนทางสายราก"
giver_name = "ทหารยามอาร์วิด"
dialog_offer = "รากเลื้อยเลื้อยเข้ามาถึงกำแพงเมืองแล้ว หมาป่าหนามก็ตามมาติด ๆ... พวกมันไม่ได้มาบุกหรอก มันหนีอะไรบางอย่างในป่าลึกมา\n\nช่วยลดจำนวนพวกมันลงหน่อย ก่อนที่มันจะล้นเข้ามาในเมือง"
dialog_progress = "รากเลื้อย 15 ตัว หมาป่าหนาม 10 ตัว บนทางสายราก ทางที่เจ้าเดินมานั่นแหละ"
dialog_complete = "เบาลงเยอะ... เจ้าสังเกตไหม พวกมันวิ่งมาจากทิศเดียวกันหมด ทิศตะวันออก — ทางไปบ่อน้ำ"
objectives = Array[ExtResource("2_obj")]([SubResource("Obj_0"), SubResource("Obj_1")])
kill_monster_id = &""
required_level = 38
required_quests = Array[StringName]([&"c3_1_open_gate"])
reward_item_id = &"bark_armor"
reward_item_count = 1
reward_zeny = 6000
reward_exp = 12000
