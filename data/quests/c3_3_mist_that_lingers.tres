[resource]
script = ExtResource("1_quest")
id = &"c3_3_mist_that_lingers"
title = "C3-3 หมอกที่ไม่จาง"
description = "บึงหมอกเงินมีหมอกหนาผิดปกติ ล่าภูตหมอกและเก็บแก่นหมอกมาให้ซิฟาทำยา"
giver_name = "แม่ค้าซิฟา"
dialog_offer = "หมอกในบึงไม่จางมาตั้งแต่ปีที่บ่อน้ำเริ่มแห้ง ข้าต้องการแก่นหมอกห้าก้อนมาทำยา... และช่วยไล่ภูตพวกนั้นให้ห่างจากคนเก็บสมุนไพรด้วย"
dialog_progress = "ภูตหมอก 12 ตัว แก่นหมอก 5 ก้อน ในบึงหมอกเงินทางตะวันออกของเมือง"
dialog_complete = "ขอบใจ... หมอกพวกนี้ไม่ใช่หมอกธรรมดา มันคือ «ลมหายใจ» ของบึงที่กำลังจะตาย — เอาผ้าคลุมนี้ไป ทอจากแก่นหมอกเหมือนกัน"
objectives = Array[ExtResource("2_obj")]([SubResource("Obj_0"), SubResource("Obj_1")])
kill_monster_id = &""
required_level = 42
required_quests = Array[StringName]([&"c3_2_roots_in_town"])
reward_item_id = &"mist_cloak"
reward_item_count = 1
reward_zeny = 8000
reward_exp = 16000
