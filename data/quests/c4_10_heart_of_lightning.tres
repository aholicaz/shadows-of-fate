[resource]
script = ExtResource("1_quest")
id = &"c4_10_heart_of_lightning"
title = "หัวใจที่ยังเต้น"
description = "ล้มหรุงนีร์ศิลาที่หลุมหัวใจสายฟ้า แล้วตรวจดูสิ่งที่อยู่ในอกของมัน"
giver_name = "ผู้อาวุโสสกาดี"
dialog_offer = "หรุงนีร์ จอมพลของยักษ์ สู้กับธอร์ตัวต่อตัวแล้วตาย — ตำนานของพวกเจ้าจบแค่ตรงนั้น\n\nแต่คืนถัดมา ศพของเขาลุกขึ้น แล้วทำลายเมืองที่เขาเคยปกป้องด้วยมือตัวเอง\n\nไปที่หลุมหัวใจสายฟ้า ล้มเขาให้ได้... แล้วดูว่าอะไรฝังอยู่ในอกของเขา"
dialog_progress = "หรุงนีร์ศิลาอยู่ก้นหลุม ทางตะวันออกของกำแพง ช่วงท้ายการต่อสู้อกของมันจะเปิดออก — ตอนนั้นแหละ"
dialog_complete = "หัวใจสายฟ้า... และมีตราค้อนสลักอยู่ ธอร์ไม่ได้ลงมือทำลายเมืองเราเอง เขาฝังหัวใจนี้ไว้ ให้จอมพลของเราลุกขึ้นมาทำลายเมืองตัวเอง\n\nเลฟยืนดูอยู่ไกล ๆ ตั้งแต่เจ้าลงหลุม เขาไม่กลัวเจ้าแล้ว\n\nไปเถอะ อัลฟ์เฮมอยู่ทางเหนือ ตรงที่รากโผล่ขึ้นจากหลุม ระวังแสงให้ดี"
objectives = Array[ExtResource("2_obj")]([SubResource("Obj_0"), SubResource("Obj_1")])
kill_monster_id = &""
required_level = 71
required_quests = Array[StringName]([&"c4_9_breach_on_the_south"])
set_flag_on_complete = &"chapter4_done"
choice_prompt = "หัวใจสายฟ้ายังเต้นตุบ ๆ อยู่ในมือเจ้า... จะทำอย่างไรกับมัน"
choice_options = Array[String](["ทุบทิ้ง — ให้หรุงนีร์ได้พักเสียที (เสียหลักฐาน)", "เก็บไว้เป็นหลักฐาน (ได้ «หัวใจสายฟ้า»)"])
choice_flags = Array[StringName]([&"smash_heart", &"keep_heart"])
cutscene_pan_npc = "เด็กยักษ์เลฟ"
cutscene_text = "เลฟยืนอยู่ที่ขอบหลุม ไกลออกไปจนดูตัวเล็กนิดเดียว... เขาโบกมือให้เจ้า แล้ววิ่งกลับเข้าเมือง"
reward_item_id = &"hrungnir_shard"
reward_item_count = 1
reward_zeny = 3974
reward_exp = 11923
reward_job_exp = 8346
