[resource]
script = ExtResource("1_quest")
id = &"c4_1_gate_of_giants"
title = "ประตูที่สูงเกินเอื้อม"
description = "ทำความรู้จักผู้คนในอุทการ์ด — ทหารยาม พ่อค้า และนักบวชที่ตามมาจากวิหาร"
giver_name = "ผู้อาวุโสสกาดี"
dialog_offer = "มนุษย์เดินผ่านช่องเขามาคนเดียว ไม่มีกองทัพตามหลัง... งั้นเจ้าคงไม่ได้มาเพื่อฆ่าใคร\n\nก่อนจะเดินในเมืองข้า ไปให้ผู้คนรู้จักหน้าเจ้าก่อน ธยาซีที่ประตู ฮือเมียร์ที่ตลาด และนักบวชจากวิหารของเจ้าที่ตามมาถึงนี่ เขายืนรออยู่หน้าบ้านข้าตั้งแต่เช้าแล้ว"
dialog_progress = "ธยาซีจะด่าเจ้า ปล่อยเขาไป ฮือเมียร์จะพยายามขายของ ส่วนอาสมุนด์... ฟังเขาให้ดี สิ่งที่เขาพูดไม่ได้ผิดไปเสียหมด"
dialog_complete = "ครบทุกคนแล้ว... นี่ตราโยตุน ถือไว้ คนในนครนี้จะรู้ว่าเจ้าเป็นแขก ไม่ใช่ศัตรู\n\nมนุษย์คนสุดท้ายที่ได้ตรานี้ไป... เขาชื่ออะไรนะ แปลกจริง ข้าจำไม่ได้ ราวกับมีใครมาลบชื่อนั้นออกไปจากหัวข้า"
objectives = Array[ExtResource("2_obj")]([SubResource("Obj_0"), SubResource("Obj_1"), SubResource("Obj_2")])
kill_monster_id = &""
required_level = 60
required_flag = &"chapter3_done"
set_flag_on_complete = &"utgard_intro"
reward_item_id = &"jotun_seal"
reward_item_count = 1
reward_zeny = 1045
