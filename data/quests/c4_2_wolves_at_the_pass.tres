[resource]
script = ExtResource("1_quest")
id = &"c4_2_wolves_at_the_pass"
title = "หมาป่าที่ช่องเขา"
description = "หมาป่าน้ำแข็งกับเหยี่ยวหิมะดักปล้นกองคาราวานที่ช่องเขาน้ำแข็ง ไปจัดการพวกมัน"
giver_name = "พ่อค้าฮือเมียร์"
dialog_offer = "กองคาราวานของข้าเข้าเมืองไม่ได้มาสามอาทิตย์แล้ว หมาป่าน้ำแข็งล่ากันเป็นฝูง ส่วนเหยี่ยวหิมะก็โฉบลงมาจากข้างบน\n\nช่วยลดจำนวนพวกมันลงหน่อย ข้าจ่ายเป็นของ — เสื้อขนหมาป่าตัวที่ดีที่สุดในร้าน"
dialog_progress = "หมาป่าน้ำแข็ง 20 ตัว เหยี่ยวหิมะ 12 ตัว ที่ช่องเขาน้ำแข็ง ทางที่เจ้าเดินมานั่นแหละ"
dialog_complete = "ทางโล่งขึ้นเยอะ... นี่เสื้อขนหมาป่า ข้าตัดให้พอดีตัวเจ้าแล้ว\n\nรู้ไหมทำไมหมาป่าถึงลงมาถึงช่องเขา — ทางเหนือมีอะไรบางอย่างที่พวกมันกลัว"
objectives = Array[ExtResource("2_obj")]([SubResource("Obj_0"), SubResource("Obj_1")])
kill_monster_id = &""
required_level = 60
required_quests = Array[StringName]([&"c4_1_gate_of_giants"])
reward_item_id = &"frost_wolf_coat"
reward_item_count = 1
reward_zeny = 1673
reward_exp = 6693
reward_job_exp = 4685
