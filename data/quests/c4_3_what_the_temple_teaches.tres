[resource]
script = ExtResource("1_quest")
id = &"c4_3_what_the_temple_teaches"
title = "สิ่งที่วิหารสอน"
description = "ล่าโทรลล์น้ำแข็ง 15 ตัวที่ทุ่งหญ้ายักษ์ แล้วนำตำราวิหารไปให้ผู้อาวุโสสกาดี"
giver_name = "นักบวชอาสมุนด์"
dialog_offer = "ข้าพกตำราที่วิหารใช้สอนเด็กมาด้วย บทแรกเขียนว่า «ยักษ์คือศัตรูของมนุษย์»\n\nโทรลล์น้ำแข็งที่ทุ่งหญ้าคอยทำร้ายคนเดินทางอยู่เสมอ ไปจัดการพวกมันก่อน — ให้ข้าเห็นว่าแดนยักษ์ก็มีสัตว์ร้ายจริง ๆ แล้วเอาตำรานี้ไปให้ผู้อาวุโสสกาดี ข้าอยากรู้ว่านางจะว่ายังไง"
dialog_progress = "โทรลล์น้ำแข็ง 15 ตัวที่ทุ่งหญ้ายักษ์ แล้วเอาตำราไปให้สกาดี"
dialog_complete = "นางว่ายังไง... หัวเราะใช่ไหม\n\nข้าไม่โกรธหรอก ข้าแค่... ตำรานั่นสอนข้ามาทั้งชีวิต ถ้ามันผิดไปครึ่งหนึ่ง แล้วอีกครึ่งที่เหลือล่ะ ผิดด้วยหรือเปล่า"
objectives = Array[ExtResource("2_obj")]([SubResource("Obj_0"), SubResource("Obj_1")])
kill_monster_id = &""
required_level = 62
required_quests = Array[StringName]([&"c4_1_gate_of_giants"])
choice_prompt = "สกาดีขอให้เจ้าอ่านตำราออกเสียงกลางเมือง — รวมถึงบรรทัด «ยักษ์กินเด็ก» ต่อหน้าเด็ก ๆ ยักษ์"
choice_options = Array[String](["อ่านออกเสียง (สกาดีหัวเราะ ธยาซีโกรธ)", "เก็บตำราไว้ ไม่อ่าน"])
choice_flags = Array[StringName]([&"read_aloud", &"kept_book"])
reward_item_id = &"temple_primer"
reward_item_count = 1
reward_zeny = 1424
reward_exp = 7123
reward_job_exp = 4986
