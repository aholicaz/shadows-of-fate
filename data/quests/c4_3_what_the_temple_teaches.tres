[resource]
script = ExtResource("1_quest")
id = &"c4_3_what_the_temple_teaches"
title = "C4-3 สิ่งที่วิหารสอน"
description = "ล่าโทรลล์น้ำแข็งที่ทุ่งหญ้า แล้วนำตำราวิหารไปให้ผู้อาวุโสสกาดี «อ่าน»"
giver_name = "นักบวชอาสมุนด์"
dialog_offer = "ข้าเอาตำราเด็กของวิหารมาด้วย บทแรก: ยักษ์คือศัตรูของมนุษย์\n\nไปล่าโทรลล์ให้ข้าเห็นว่ายักษ์ก็มีสัตว์ประหลาดของมัน แล้วเอาตำรานี้ไปให้ผู้อาวุโส ข้าอยากรู้ว่านางจะว่ายังไง"
dialog_progress = "โทรลล์น้ำแข็ง 15 ตัวที่ทุ่งหญ้ายักษ์ แล้วเอาตำราไปให้สกาดี"
dialog_complete = "นางว่ายังไง... หัวเราะสินะ\n\nข้าไม่โกรธ ข้าแค่... ตำรานั่นสอนข้ามาทั้งชีวิต ถ้ามันผิดครึ่งหนึ่ง อีกครึ่งผิดด้วยไหม"
objectives = Array[ExtResource("2_obj")]([SubResource("Obj_0"), SubResource("Obj_1")])
kill_monster_id = &""
required_level = 62
required_quests = Array[StringName]([&"c4_1_gate_of_giants"])
choice_prompt = "สกาดีขอให้เจ้าอ่านตำราออกเสียงกลางเมือง — «ยักษ์กินเด็ก» ต่อหน้าเด็กยักษ์"
choice_options = Array[String](["อ่านออกเสียง (สกาดีหัวเราะ ธยาซีโกรธ)", "เก็บตำราไว้ ไม่อ่าน"])
choice_flags = Array[StringName]([&"read_aloud", &"kept_book"])
reward_item_id = &"temple_primer"
reward_item_count = 1
reward_zeny = 8000
reward_exp = 40000
