[resource]
script = ExtResource("1_quest")
id = &"c4_5_wall_they_call_ours"
title = "C4-5 กำแพงที่พวกเขาเรียกว่าของเรา"
description = "ล่าทหารหินยักษ์ที่กำแพง แล้วอ่านจารึกฝั่งยักษ์บนกำแพง"
giver_name = "ทหารยามธยาซี"
dialog_offer = "มนุษย์เรียกมันว่ากำแพงกันยักษ์ พวกเจ้าสร้างมัน... ใช่ไหม\n\nไปที่กำแพง ล่าทหารหินที่ยังเดินตามคำสั่งเก่า แล้วอ่านจารึกบนกำแพง — จารึกฝั่งเรา ไม่ใช่ฝั่งเจ้า"
dialog_progress = "ทหารหิน 12 ตัว แล้วหาจารึกรูนยักษ์ที่กำแพง ตัวอักษรใหญ่เท่าประตู มองไม่พลาดหรอก"
dialog_complete = "«สร้างเพื่อกันฟ้า ไม่ใช่กันคน» — ยักษ์สร้างกำแพงนั้น มนุษย์ ไม่ใช่พวกเจ้า\n\nเอาโล่หินนี่ไป ตัดจากกำแพงเดียวกัน"
objectives = Array[ExtResource("2_obj")]([SubResource("Obj_0"), SubResource("Obj_1")])
kill_monster_id = &""
required_level = 65
required_quests = Array[StringName]([&"c4_2_wolves_at_the_pass"])
reward_item_id = &"wall_shield"
reward_item_count = 1
reward_zeny = 12000
reward_exp = 60000
