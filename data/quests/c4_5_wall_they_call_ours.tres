[resource]
script = ExtResource("1_quest")
id = &"c4_5_wall_they_call_ours"
title = "กำแพงที่พวกเขาเรียกว่าของเรา"
description = "ล่าทหารหินยักษ์ 12 ตัวที่กำแพงที่แตก แล้วอ่านจารึกภาษายักษ์บนกำแพง"
giver_name = "ทหารยามธยาซี"
dialog_offer = "ที่บ้านเจ้าเรียกกำแพงทางใต้ว่า «กำแพงกันยักษ์» ใช่ไหม วิหารสอนว่ามนุษย์สร้างมันไว้กันพวกข้า\n\nไปดูให้เห็นกับตา ทหารหินที่นั่นยังเดินเฝ้าตามคำสั่งเมื่อสามร้อยปีก่อน จัดการพวกมัน แล้วอ่านจารึกบนกำแพง — จารึกภาษายักษ์ ฝั่งที่มนุษย์ไม่เคยอ่าน"
dialog_progress = "ทหารหินยักษ์ 12 ตัว แล้วหาจารึกภาษายักษ์บนกำแพง ตัวอักษรใหญ่เท่าประตู มองไม่พลาดหรอก"
dialog_complete = "«สร้างไว้กันภัยจากฟ้า ไม่ได้สร้างไว้กันคน» — นั่นคือสิ่งที่จารึกบอก บรรพบุรุษข้าเป็นคนสร้างกำแพงนั้น ไม่ใช่มนุษย์\n\nและ «ภัยจากฟ้า» ที่ว่า... ก็คือพวกที่ลงมาพร้อมสายฟ้า เอาโล่นี่ไป มันตัดจากหินก้อนเดียวกับกำแพง"
objectives = Array[ExtResource("2_obj")]([SubResource("Obj_0"), SubResource("Obj_1")])
kill_monster_id = &""
required_level = 65
required_quests = Array[StringName]([&"c4_2_wolves_at_the_pass"])
reward_item_id = &"wall_shield"
reward_item_count = 1
reward_zeny = 1558
reward_exp = 7792
reward_job_exp = 5454
