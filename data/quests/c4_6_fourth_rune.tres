id = &"c4_6_fourth_rune"
title = "C4-6 รูนดวงที่สี่"
description = "หาแกนหินยักษ์กับเขี้ยวน้ำแข็งมาให้เกอร์ดสลักรูน"
giver_name = "ช่างสลักรูนเกอร์ด"
dialog_offer = "ข้าจะสลักรูนให้เจ้าดูดวงหนึ่ง แต่ต้องมีหิน — แกนหินจากอกทหารหิน 5 ก้อน กับเขี้ยวน้ำแข็ง 10 ซี่ไว้ทำสิ่ว"
dialog_progress = "แกนหินยักษ์ 5 จากทหารหินที่โถงน้ำแข็งหรือกำแพง เขี้ยวน้ำแข็ง 10 จากหมาป่า"
dialog_complete = "ดวงที่สี่... «กำเนิด» ฟังเสียงสิ่วสิ มันร้องเหมือนตอนที่ธอร์เอามันไปครั้งแรก\n\nเอาค้อนสลักนี่ไป ข้าไม่ต้องใช้แล้ว วันหนึ่งเจ้าจะต้องสลักอะไรที่ข้าสลักไม่ได้"
