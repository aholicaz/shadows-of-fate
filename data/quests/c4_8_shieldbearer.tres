[resource]
script = ExtResource("1_quest")
id = &"c4_8_shieldbearer"
title = "ผู้ที่ยังยืนเฝ้า"
description = "ล้มผู้ถือโล่แห่งกำแพง ผู้ยังยืนขวางทางไปหลุมหัวใจสายฟ้า"
giver_name = "ทหารยามธยาซี"
dialog_offer = "ผู้ถือโล่... ทหารยักษ์คนสุดท้ายที่ยังยืนเฝ้ากำแพง เขายืนอยู่ตรงนั้นมาสามร้อยปี จนจำไม่ได้แล้วว่ากำลังเฝ้าอะไร\n\nเขาไม่ยอมให้ใครผ่านไปหลุมหัวใจสายฟ้า ไม่ว่ายักษ์หรือมนุษย์ ข้าไม่อยากขอให้เจ้าฆ่าเขา... แต่ถ้าจะไปถึงหลุม ก็ไม่มีทางอื่น"
dialog_progress = "ผู้ถือโล่อยู่ป้อมปลายกำแพงทางตะวันออก ระวังตอนเขากระแทกโล่ คลื่นกระแทกจะวิ่งออกทั้งซ้ายและขวา"
dialog_complete = "เขาพูดอะไรก่อนตายไหม... «ข้ายืนผิดข้าง» สินะ\n\nนี่เกราะของเขา ยักษ์คนสุดท้ายแห่งกำแพง — สวมมันไว้ ให้เกราะนี้ได้ยืนเฝ้าต่อบนตัวเจ้า\n\nคืนนี้อย่าเพิ่งไปหลุม ตอนกลางคืนที่กำแพง... มีบางอย่างที่คนเป็นไม่ควรเห็น แต่เจ้าอาจต้องเห็น"
objectives = Array[ExtResource("2_obj")]([SubResource("Obj_0")])
kill_monster_id = &""
required_level = 69
required_quests = Array[StringName]([&"c4_7_hall_of_ice"])
set_flag_on_complete = &"c4_8_done"
reward_item_id = &"wall_plate"
reward_item_count = 1
reward_zeny = 2273
reward_exp = 10911
reward_job_exp = 7637
