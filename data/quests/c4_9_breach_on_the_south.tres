[resource]
script = ExtResource("1_quest")
id = &"c4_9_breach_on_the_south"
title = "รอยแตกอยู่ฝั่งใต้"
description = "ตรวจรอยแตกของกำแพง แล้วกลับมาคุยกับอาสมุนด์อีกครั้ง"
giver_name = "ผู้อาวุโสสกาดี"
dialog_offer = "ผู้ถือโล่ล้มแล้ว ทางไปหลุมเปิดแล้ว... แต่ก่อนไป ข้าอยากให้เจ้าไปดูรอยแตกของกำแพงให้ดีอีกครั้ง\n\nดูว่าเศษหินกระเด็นไปทางไหน แล้วเอาสิ่งที่เห็นไปบอกอาสมุนด์ นักบวชของเจ้า"
dialog_progress = "รอยแตกอยู่กลางกำแพงที่แตก ดูขอบรอยให้ดี แล้วไปคุยกับอาสมุนด์"
dialog_complete = "เศษหินกองอยู่ฝั่งเรา... แปลว่ากำแพงถูกทุบเข้ามาจากฝั่งใต้ ฝั่งของมนุษย์\n\nอาสมุนด์บอกว่าจะกลับไปถามวิหารสินะ... เขาเป็นคนดี มนุษย์ ข้าหวังว่าวิหารจะไม่ลงโทษเขาเพียงเพราะเขาถาม"
objectives = Array[ExtResource("2_obj")]([SubResource("Obj_0"), SubResource("Obj_1")])
kill_monster_id = &""
required_level = 70
required_quests = Array[StringName]([&"c4_8_shieldbearer"])
set_flag_on_complete = &"c4_9_done"
reward_zeny = 1121
reward_exp = 5606
reward_job_exp = 3924
