[gd_resource type="Resource" script_class="QuestData" load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/resources/quest_data.gd" id="1_quest"]
[ext_resource type="Script" path="res://scripts/resources/objective_data.gd" id="2_obj"]

[sub_resource type="Resource" id="Obj_0"]
script = ExtResource("2_obj")
kind = 4
target = &"wall_breach"
count = 1

[sub_resource type="Resource" id="Obj_1"]
script = ExtResource("2_obj")
kind = 2
target = &"นักบวชอาสมุนด์"
count = 1
text = "บอกอาสมุนด์เรื่องรอยแตก"

[resource]
script = ExtResource("1_quest")
id = &"c4_9_breach_on_the_south"
title = "C4-9 รอยแตกอยู่ฝั่งใต้"
description = "ตรวจรอยแตกของกำแพง แล้วกลับมาคุยกับอาสมุนด์อีกครั้ง"
giver_name = "ผู้อาวุโสสกาดี"
dialog_offer = "ผู้ถือโล่ตายแล้ว ทางไปหลุมเปิด... แต่ก่อนไป ไปดูรอยแตกของกำแพงให้ดี\n\nดูว่าหินกระเด็นไปทางไหน แล้วเอาคำตอบไปบอกนักบวชของเจ้า"
dialog_progress = "รอยแตกอยู่กลางกำแพง ดูขอบให้ดี แล้วกลับมาคุยกับอาสมุนด์"
dialog_complete = "หินอยู่ข้างใน... กำแพงถูกทุบจากฝั่งใต้ ฝั่งมนุษย์\n\nอาสมุนด์บอกว่าจะกลับไปถามวิหารสินะ... เขาเป็นคนดี มนุษย์ ข้าหวังว่าวิหารจะไม่ทำร้ายเขาเพราะคำถาม"
objectives = Array[ExtResource("2_obj")]([SubResource("Obj_0"), SubResource("Obj_1")])
kill_monster_id = &""
required_level = 70
required_quests = Array[StringName]([&"c4_8_shieldbearer"])
set_flag_on_complete = &"c4_9_done"
reward_zeny = 20000
reward_exp = 100000
