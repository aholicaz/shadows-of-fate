[resource]
script = ExtResource("1_quest")
id = &"c5_10_the_conduit"
title = "ผู้ที่เป็นท่อ"
description = "ล้มอัลฟ์เรืองรอง (ดาเกอร์ในร่างท่อแสง) ที่วิหารบ่อแสง แล้วตรวจดูท่อราก"
giver_name = "ผู้เห็นแสงเอย์ร"
dialog_offer = "ดาเกอร์หายไปจากเมืองแล้ว เขาไม่ได้หนีไปไหน เขาไปที่วิหารบ่อแสง\n\nเจ้าเมืองทุกคนของลโยซาลฟ์จบลงที่เดียวกัน — ยืนกลางบ่อแสง ให้ร่างกายตัวเองเป็นท่อที่แสงไหลผ่าน\n\nไปล้มเขาเสีย มนุษย์ แล้วดูว่าท่อนั้นต่อไปที่ไหน"
dialog_progress = "อัลฟ์เรืองรองอยู่กลางวิหารบ่อแสง ช่วงกลางการต่อสู้เขาจะทำให้ห้องมืด — ระวังลำแสงที่ตกลงมาจากข้างบน"
dialog_complete = "ท่อรากต่อขึ้นไปที่อิกดราซิล... และอีกเส้นดิ่งลงใต้ดิน\n\nเจ้าเลือกไปแล้ว ข้าไม่ถามหรอกว่าเลือกอะไร ข้าตาบอด มองไม่เห็นว่าเมืองมืดหรือสว่าง\n\nแต่ข้าได้ยินเสียงอิลวา... เธอกำลังแหงนมองฟ้า"
objectives = Array[ExtResource("2_obj")]([SubResource("Obj_0"), SubResource("Obj_1")])
kill_monster_id = &""
required_level = 84
required_quests = Array[StringName]([&"c5_9_where_the_light_goes"])
set_flag_on_complete = &"chapter5_done"
choice_prompt = "แสงหยุดไหลแล้ว ทั้งเมืองมืดลงเป็นครั้งแรกในรอบพันปี... เอย์รถามเจ้าว่าจะทำอย่างไรกับท่อรากนี้"
choice_options = Array[String](["ปล่อยให้มืด — ให้เอลฟ์กลับมารู้สึก", "ต่อแสงกลับ — ให้เมืองสงบต่อ แต่รู้แล้วว่าแลกอะไร"])
choice_flags = Array[StringName]([&"let_dark", &"restore_light"])
cutscene_pan_npc = "เด็กเอลฟ์อิลวา"
cutscene_text = "อิลวายืนอยู่กลางเมือง เงยหน้าขึ้น... บนฟ้าที่ไม่เคยมืด มีจุดสว่างเล็ก ๆ ปรากฏขึ้น\n\nเธอชี้ขึ้นไป แล้วร้องไห้เป็นครั้งที่สอง"
reward_item_id = &"dagr_core"
reward_item_count = 1
reward_zeny = 5315
reward_exp = 23625
reward_job_exp = 16537
