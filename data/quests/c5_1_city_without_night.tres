[resource]
script = ExtResource("1_quest")
id = &"c5_1_city_without_night"
title = "เมืองที่ไม่มีกลางคืน"
description = "ทำความรู้จักผู้คนในลโยซาลฟ์ แล้วถามทุกคนว่า «กลางคืนล่ะ»"
giver_name = "ผู้เห็นแสงเอย์ร"
dialog_offer = "เจ้ามาจากดินแดนที่ยังมีกลางคืน... ข้าได้กลิ่นหิมะติดเสื้อเจ้ามา\n\nไปทำความรู้จักเจ้าเมืองดาเกอร์ แม่ค้าลอฟน์ และยามโซลที่ประตู แล้วลองถามทุกคนว่า «กลางคืนหายไปไหน» — ดูสีหน้าพวกเขาให้ดี"
dialog_progress = "ดาเกอร์อยู่กลางเมือง ลอฟน์อยู่ที่ร้าน โซลอยู่ที่ประตู ถามทุกคนเรื่องกลางคืน"
dialog_complete = "ไม่มีใครรู้จักกลางคืนเลย... ใช่ไหม\n\nนี่ตราแสง ถือไว้ แล้วคนในเมืองจะยิ้มให้เจ้า — อีกไม่นานเจ้าจะเริ่มเห็นว่ารอยยิ้มพวกนั้นแปลกตรงไหน"
objectives = Array[ExtResource("2_obj")]([SubResource("Obj_0"), SubResource("Obj_1"), SubResource("Obj_2")])
kill_monster_id = &""
required_level = 72
required_flag = &"chapter4_done"
set_flag_on_complete = &"ljosalf_intro"
reward_item_id = &"light_seal"
