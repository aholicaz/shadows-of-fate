[resource]
script = ExtResource("1_quest")
id = &"c5_1_city_without_night"
title = "C5-1 เมืองที่ไม่มีกลางคืน"
description = "ทำความรู้จักผู้คนในลโยซาลฟ์ แล้วถามทุกคนว่า «กลางคืนล่ะ»"
giver_name = "ผู้เห็นแสงเอย์ร"
dialog_offer = "เจ้ามาจากที่ที่มีกลางคืน ข้าได้กลิ่นหิมะบนเสื้อเจ้า\n\nไปคุยกับเจ้าเมืองดาเกอร์ แม่ค้าลอฟน์ และยามโซล — แล้วถามทุกคนว่า «กลางคืนล่ะ» ดูหน้าพวกเขาให้ดี"
dialog_progress = "ดาเกอร์กลางเมือง ลอฟน์ที่ร้าน โซลที่ประตู ถามเรื่องกลางคืนทุกคน"
dialog_complete = "ไม่มีใครรู้ว่ากลางคืนคืออะไร... ใช่ไหม\n\nนี่ตราแสง ถือไว้ เมืองจะยิ้มให้เจ้า — และเจ้าจะเริ่มเห็นว่ารอยยิ้มนั้นแปลกตรงไหน"
objectives = Array[ExtResource("2_obj")]([SubResource("Obj_0"), SubResource("Obj_1"), SubResource("Obj_2")])
kill_monster_id = &""
required_level = 72
required_flag = &"chapter4_done"
set_flag_on_complete = &"ljosalf_intro"
reward_item_id = &"light_seal"
reward_item_count = 1
reward_zeny = 8000
reward_exp = 40000
