script = ExtResource("1_quest")
id = &"c5_2_gift_of_light"
title = "ของขวัญแห่งแสง"
description = "ล่าผีเสื้อแสง 20 ตัวและกวางผลึก 8 ตัวบนทางประกายแสง"
giver_name = "เจ้าเมืองดาเกอร์"
dialog_offer = "แขกของเมือง (ยิ้ม) ช่วงนี้ผีเสื้อแสงบินเข้าเมืองมากเกินไป ส่วนกวางผลึกก็มากินสวนของเรา ช่วยจัดการพวกมันที\n\nแล้วข้าจะให้ของขวัญ — ผลึกแสง สวมมันแล้วเจ้าจะเห็นเมืองนี้อย่างที่มันเป็น"
dialog_progress = "ผีเสื้อแสง 20 ตัว กวางผลึก 8 ตัว บนทางประกายแสง"
dialog_complete = "ขอบใจ (ยิ้ม) นี่ผลึกแสง สวมไว้แล้วทุกอย่างจะสว่างอยู่เสมอ\n\nที่นี่ไม่มีอะไรผิดปกติ ไม่เคยมี"
objectives = Array[ExtResource("2_obj")]([SubResource("Obj_0"), SubResource("Obj_1")])
