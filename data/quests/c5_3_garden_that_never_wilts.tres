script = ExtResource("1_quest")
id = &"c5_3_garden_that_never_wilts"
title = "C5-3 สวนที่ไม่มีวันเหี่ยว"
description = "ล่าดอกไม้กลืนแสงในสวนผลึก แล้วอ่านสมุดของคนสวน"
giver_name = "แม่ค้าลอฟน์"
dialog_offer = "ดอกไม้ในสวนบานเหมือนทุกวัน ☺ แต่ช่วงนี้มันกินแสงมากไป คนสวนบ่น... ไม่สิ คนสวนไม่บ่น ไม่มีใครบ่น\n\nไปตัดให้บาง แล้วดูสมุดของคนสวนหน่อย เขาจดอะไรทุกวัน"
dialog_progress = "ดอกไม้กลืนแสง 12 แล้วหาสมุดจดที่ปลายสวน"
dialog_complete = "«วันนี้ข้าลืมชื่อแม่»... ☺ ...ทำไมข้าถึงหยุดยิ้มไม่ได้\n\nเอาผ้าคลุมนี่ไป ราคาลงท้ายด้วยศูนย์ ฟรี"
objectives = Array[ExtResource("2_obj")]([SubResource("Obj_0"), SubResource("Obj_1")])
