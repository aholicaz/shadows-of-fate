[resource]
script = ExtResource("1_quest")
id = &"c5_4_child_who_never_saw_stars"
title = "เด็กที่ไม่เคยเห็นดาว"
description = "คุยกับเด็กเอลฟ์อิลวา — ถ้าเจ้ามีเพลงของฟรีดา ให้เธอฟัง"
giver_name = "ผู้เห็นแสงเอย์ร"
dialog_offer = "อิลวา เด็กท้ายเมือง เที่ยวถามทุกคนว่า «ดาว» คืออะไร ไม่มีใครตอบได้\n\nเจ้ามีเพลงจากวานาเฮมติดตัวมาไหม เพลงของเด็กที่เคยเห็นดาวจริง ๆ... ถ้ามี ร้องให้เธอฟังที"
dialog_progress = "อิลวาอยู่ท้ายเมืองใกล้ผลึกใหญ่ คุยกับเธอ"
dialog_complete = "เธอร้องไห้... เป็นครั้งแรกในชีวิต\n\nแสงของเมืองนี้กรองความเศร้าออกไปจนหมด แต่กรองเพลงของเด็กจากอีกโลกหนึ่งไม่ได้\n\nเธอแต่งเพลงตอบกลับมาด้วย นี่ — เพลงของอิลวา"
objectives = Array[ExtResource("2_obj")]([SubResource("Obj_0")])
kill_monster_id = &""
required_level = 76
required_quests = Array[StringName]([&"c5_1_city_without_night"])
set_flag_on_complete = &"ylva_cried"
reward_item_id = &"ylva_song"
reward_item_count = 1
