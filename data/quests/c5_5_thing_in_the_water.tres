[resource]
script = ExtResource("1_quest")
id = &"c5_5_thing_in_the_water"
title = "สิ่งที่อยู่ในน้ำ"
description = "ล่าเงาสะท้อนที่ทะเลสาบกระจก เก็บผลึกเงาที่มันทิ้งไว้ แล้วมองเงาในน้ำกลางทะเลสาบ"
giver_name = "ทหารยามโซล"
dialog_offer = "ในทะเลสาบกระจกมี «อะไรบางอย่าง» อยู่ในน้ำ มันเลียนแบบท่าทางของคนที่มองมัน ข้าไม่ชอบมันเลย... ไม่สิ ข้าไม่ได้รู้สึกอะไรทั้งนั้น (ยิ้ม)\n\nไปจัดการมันที แล้วเอาของที่มันทิ้งไว้มาให้ข้าดู"
dialog_progress = "เงาสะท้อน 5 ตัวที่ทะเลสาบกระจก เก็บผลึกเงาที่มันทิ้งไว้ แล้วมองเงาในน้ำกลางทะเลสาบ"
dialog_complete = "ผลึกเงา... ข้า... ข้าจำได้ ข้าเคย...\n\n(โซลเงียบไป รอยยิ้มยังค้างอยู่บนหน้า แต่ดวงตาไม่ได้ยิ้มแล้ว)\n\n...เก็บผลึกนี้ไว้ มนุษย์ มันจะให้เจ้าเห็นเมืองนี้อีกร่างหนึ่ง — ร่างที่แสงจางลง ไปแตะผลึกใหญ่ท้ายเมือง แล้วดูว่าใครยังอยู่ ใครหายไป"
objectives = Array[ExtResource("2_obj")]([SubResource("Obj_0"), SubResource("Obj_1"), SubResource("Obj_2")])
kill_monster_id = &""
required_level = 78
required_quests = Array[StringName]([&"c5_3_garden_that_never_wilts"])
set_flag_on_complete = &"has_shade_crystal"
reward_zeny = 2350
reward_exp = 14104
reward_job_exp = 9872
