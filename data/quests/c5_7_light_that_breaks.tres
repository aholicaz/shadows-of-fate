description = "ล่านางฟ้าน้ำและเก็บน้ำตาผลึกให้โวลุนด์"
giver_name = "ช่างแสงโวลุนด์"
dialog_offer = "น้ำตาผลึกจากนางฟ้าน้ำ — ข้าใช้มันตีบวกด้วยแสง ☺ เพลงของพวกนางทำให้แสงจับตัวได้\n\nเอามา 5 เม็ด แล้วข้าจะตีดาบผลึกแสงให้เจ้า สมบูรณ์แบบ"
dialog_progress = "นางฟ้าน้ำ 12 น้ำตาผลึก 5 ที่ทะเลสาบกระจก"
dialog_complete = "สมบูรณ์แบบ ☺ ไม่มีรอยค้อนเลย\n\nจากนี้ข้าตีบวกด้วยแสงให้เจ้าได้ สำเร็จบ่อยกว่า... แต่ถ้าพัง ไม่เหลือซากนะ ☺ นั่นแหละราคา"
objectives = Array[ExtResource("2_obj")]([SubResource("Obj_0"), SubResource("Obj_1")])
