[resource]
script = ExtResource("1_quest")
id = &"c5_8_forsaken"
title = "ผู้ที่หลุดจากแสง"
description = "«กำจัด» ผู้หลุดจากแสงที่ปลายป่าที่แสงจาง ตามคำขอของดาเกอร์"
giver_name = "เจ้าเมืองดาเกอร์"
dialog_offer = "ในป่าที่แสงจางมี... «บางสิ่ง» อยู่ (ยิ้ม) มันจำเรื่องที่ไม่ควรจำ แล้วทำให้เอลฟ์คนอื่นเริ่มจำตามไปด้วย\n\nกำจัดมันเสีย เพื่อความสงบของเมืองเรา"
dialog_progress = "ผู้หลุดจากแสงอยู่ปลายป่าที่แสงจาง เขาจะสู้กับเจ้า — เพราะเขาคิดว่าเจ้าเป็นคนที่เมืองส่งมา"
dialog_complete = "...เจ้าจัดการแล้วสินะ (ยิ้ม)\n\n(ดาเกอร์ยังยิ้มอยู่ แต่มือของเขาสั่น)"
objectives = Array[ExtResource("2_obj")]([SubResource("Obj_0")])
kill_monster_id = &""
required_level = 82
required_quests = Array[StringName]([&"c5_6_those_who_are_missing"])
set_flag_on_complete = &"c5_8_done"
choice_prompt = "ผู้หลุดจากแสงล้มลง เขามองเจ้าแล้วพูดว่า «ข้าเคยเห็นดาว...» เขายังหายใจอยู่"
choice_options = Array[String](["ปล่อยเขาไป — ให้เขาจำต่อไป", "จบมัน — ตามคำสั่งเมือง"])
choice_flags = Array[StringName]([&"spared_forsaken", &"killed_forsaken"])
reward_item_id = &"elven_plate"
