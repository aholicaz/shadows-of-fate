[resource]
script = ExtResource("1_quest")
id = &"c5_9_where_the_light_goes"
title = "แสงไปไหน"
description = "ล่าเอลฟ์กลวงในป่าจาง แล้วอ่านศิลาผู้ถูกทิ้ง"
giver_name = "โซล (ผู้ถูกทิ้ง)"
dialog_offer = "เอลฟ์กลวงพวกนี้... เคยเป็นเพื่อนข้า แสงถูกดูดออกไปจนไม่เหลืออะไรในตัว\n\nช่วยปลดปล่อยพวกเขาที แล้วไปอ่านศิลากลางป่า — มันบอกว่าแสงไหลไปที่ไหน"
dialog_progress = "เอลฟ์กลวง 15 แล้วอ่านศิลากลางป่าที่แสงจาง"
dialog_complete = "«สัญญาแห่งแสง»... เราเลือกเองนะ มนุษย์ ไม่มีใครบังคับ\n\nเราแลกความเศร้าทั้งชีวิตกับความสงบ แล้วก็ลืมไปว่าเคยเลือก\n\nเอาโล่นี่ไป แล้วไปที่วิหารบ่อแสง ดูว่าแสงไหลไปไหน"
objectives = Array[ExtResource("2_obj")]([SubResource("Obj_0"), SubResource("Obj_1")])
kill_monster_id = &""
required_level = 83
required_quests = Array[StringName]([&"c5_8_forsaken"])
set_flag_on_complete = &"saw_exile_stone_q"
reward_item_id = &"crystal_shield"
reward_item_count = 1
reward_zeny = 3006
reward_exp = 18041
reward_job_exp = 12628
