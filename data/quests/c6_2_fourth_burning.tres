[resource]
script = ExtResource("1_quest")
id = &"c6_2_fourth_burning"
title = "การเผาครั้งที่สี่"
description = "ล่าผีหมอก 20 ตนและหมาป่าเฮล 10 ตัวที่ฝั่งหมอกน้ำแข็ง แล้วนำเถ้ากุลล์ไวก์มาคืนเธอ"
giver_name = "กุลล์ไวก์ (ผี)"
dialog_offer = "ผีหมอกที่ริมฝั่ง... พวกเขาคือคนที่ตายเพราะหมอกดูดลมหายใจไป ส่วนหมาป่าเฮลคอยไล่ต้อนไม่ให้พวกเขาขึ้นฝั่งได้\n\nช่วยปลดปล่อยพวกเขาที แล้วก็... ถ้าเจ้ายังเก็บเถ้าของข้าไว้ เอามาคืนข้าได้ไหม ข้าอยากเห็นว่าตัวข้าเหลืออะไรบ้าง"
dialog_progress = "ผีหมอก 20 หมาป่าเฮล 10 ที่ฝั่งหมอกน้ำแข็ง แล้วเอาเถ้ากุลล์ไวก์มาให้ (ถ้ายังมี)"
dialog_complete = "เถ้าของข้า... ยังอุ่นอยู่เลย\n\nเอาเพลิงนี่ไป ไฟที่เผาข้าสามครั้งแต่ไม่เคยมอด ให้มันลุกอยู่บนดาบเจ้า — ผู้ตายที่นี่กลัวไฟ เพราะไฟคือสิ่งเดียวที่พวกเขายังจำได้ว่าอบอุ่น"
objectives = Array[ExtResource("2_obj")]([SubResource("Obj_0"), SubResource("Obj_1"), SubResource("Obj_2")])
kill_monster_id = &""
required_level = 85
required_quests = Array[StringName]([&"c6_1_those_who_remember"])
reward_item_id = &"gullveig_flame"
reward_item_count = 1
reward_zeny = 2967
reward_exp = 19784
reward_job_exp = 13848
