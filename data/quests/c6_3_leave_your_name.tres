[resource]
script = ExtResource("1_quest")
id = &"c6_3_leave_your_name"
title = "C6-3 ทิ้งชื่อไว้ที่สะพาน"
description = "ล่าผู้ข้ามฝั่งและผีจมน้ำที่แม่น้ำ แล้ว «ยอมทิ้งชื่อ» เพื่อข้ามสะพาน"
giver_name = "ผู้เฝ้าสะพานโมดกุด"
dialog_offer = "ผู้ข้ามฝั่งเรียกค่าข้ามเกินกฎ ผีจมน้ำขึ้นมาจากบึงบท 3 ของเจ้า... จัดการให้ข้าที\n\nแล้วถ้าอยากไปโถงแห่งนาม — ทิ้งชื่อไว้กับข้า คนมีชื่อเข้าโถงแล้วจะถูกลบตาม"
dialog_progress = "ผู้ข้ามฝั่ง 12 ผีจมน้ำ 15 แล้วกลับมาทำพิธีทิ้งชื่อกับข้า"
dialog_complete = "...ชื่อของเจ้าอยู่กับข้าแล้ว\n\nรู้สึกยังไง มนุษย์ ว่างเปล่าใช่ไหม พวกเขาทุกคนรู้สึกแบบนี้ตอนข้าม\nไปเถอะ คนไร้นาม"
objectives = Array[ExtResource("2_obj")]([SubResource("Obj_0"), SubResource("Obj_1"), SubResource("Obj_2")])
kill_monster_id = &""
required_level = 86
required_quests = Array[StringName]([&"c6_2_fourth_burning"])
set_flag_on_complete = &"name_left"
reward_zeny = 20000
reward_exp = 140000
