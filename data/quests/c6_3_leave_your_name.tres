[resource]
script = ExtResource("1_quest")
id = &"c6_3_leave_your_name"
title = "ทิ้งชื่อไว้ที่สะพาน"
description = "ล่าผู้ข้ามฝั่ง 12 ตนและผีจมน้ำ 15 ตนที่แม่น้ำเกียลล์ แล้วกลับมา «ทิ้งชื่อ» ไว้กับโมดกุดเพื่อข้ามสะพาน"
giver_name = "ผู้เฝ้าสะพานโมดกุด"
dialog_offer = "พวกผู้ข้ามฝั่งเริ่มรีดค่าข้ามเกินกฎ ส่วนผีจมน้ำ... พวกทหารที่จมบึงหมอกเงินในวานาเฮม ก็ไหลตามน้ำมาถึงนี่ จัดการพวกมันให้ข้าที\n\nแล้วถ้าเจ้าอยากเข้าโถงแห่งนาม ต้องทิ้งชื่อไว้กับข้าก่อน ใครเข้าไปทั้งที่ยังมีชื่อ ชื่อนั้นจะถูกลบตามไปด้วย"
dialog_progress = "ผู้ข้ามฝั่ง 12 ผีจมน้ำ 15 แล้วกลับมาทำพิธีทิ้งชื่อกับข้า"
dialog_complete = "...ชื่อของเจ้าอยู่กับข้าแล้ว\n\nรู้สึกยังไงล่ะ มนุษย์ ว่างเปล่าใช่ไหม ทุกคนที่ข้ามไปก็รู้สึกแบบนี้\n\nไปเถอะ คนไร้นาม"
objectives = Array[ExtResource("2_obj")]([SubResource("Obj_0"), SubResource("Obj_1"), SubResource("Obj_2")])
kill_monster_id = &""
required_level = 86
required_quests = Array[StringName]([&"c6_2_fourth_burning"])
set_flag_on_complete = &"name_left"
reward_zeny = 2956
reward_exp = 20693
reward_job_exp = 14485
