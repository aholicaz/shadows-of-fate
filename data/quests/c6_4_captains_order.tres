[gd_resource type="Resource" script_class="QuestData" load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/resources/quest_data.gd" id="1_quest"]
[ext_resource type="Script" path="res://scripts/resources/objective_data.gd" id="2_obj"]

[sub_resource type="Resource" id="Obj_0"]
script = ExtResource("2_obj")
kind = 4
target = &"bridge_toll"
text = "ตรวจดูแผ่นทอง"
count = 1

[sub_resource type="Resource" id="Obj_1"]
script = ExtResource("2_obj")
kind = 2
target = &"เฮล ผู้ปกครองผู้ตาย"
count = 1
text = "ถามเฮลเรื่องคำสั่งผู้กอง"

[resource]
script = ExtResource("1_quest")
id = &"c6_4_captains_order"
title = "คำสั่งของผู้กอง"
description = "อ่านแผ่นทองที่หัวสะพานเกียลล์ แล้วถามเฮลว่าทำไมผู้กองถึงสั่งห้ามเข้าป่า"
giver_name = "นักล่าที่หายไป (ผี)"
dialog_offer = "ที่หัวสะพานทองมีแผ่นทองอยู่แผ่นหนึ่ง... ตอนข้ามมา ข้าเขียนอะไรบางอย่างไว้ใต้แผ่นนั้น แต่ตอนนี้จำไม่ได้แล้ว ไปอ่านให้ข้าที\n\nแล้วช่วยถามเฮลให้ด้วยว่า ผู้กองรู้หรือเปล่าว่าป่ากำลังถูกดูด"
dialog_progress = "อ่านแผ่นทองที่หัวสะพานเกียลล์ แล้วคุยกับเฮล"
dialog_complete = "เฮลว่ายังไง... ผู้กองรู้ รู้มาตลอด เขาสั่งห้ามเข้าป่าเพราะไม่อยากให้ใครเห็นแสงไหลลงดิน\n\nข้าไม่ได้บ้าหรอก ข้าแค่เห็นก่อนคนอื่น"
objectives = Array[ExtResource("2_obj")]([SubResource("Obj_0"), SubResource("Obj_1")])
kill_monster_id = &""
required_level = 87
required_quests = Array[StringName]([&"c6_1_those_who_remember"])
set_flag_on_complete = &"knows_captain_reason"
reward_zeny = 2079
reward_exp = 13517
reward_job_exp = 9461
