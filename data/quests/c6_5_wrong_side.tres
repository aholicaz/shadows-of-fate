[resource]
script = ExtResource("1_quest")
id = &"c6_5_wrong_side"
title = "ข้างที่ผิด"
description = "ล่าผู้เฝ้านามในโถงแห่งนาม แล้วอ่านชื่อที่ยังอ่านออกตรงกลางผนัง"
giver_name = "ผู้ถือโล่ (ผี)"
dialog_offer = "ในโถงแห่งนามมีผู้เฝ้าอยู่... รูปปั้นที่มีตัวอักษรไหลวนบนตัว พวกมันกันไม่ให้คนที่ยังมีชื่อเข้าไป\n\nตอนนี้เจ้าไม่มีชื่อแล้ว เข้าไปได้ จัดการพวกมันเสีย แล้วดูผนังตรงกลางโถง — หาชื่อที่ใหญ่กว่าชื่ออื่นทั้งหมด"
dialog_progress = "ผู้เฝ้านาม 10 แล้วอ่านชื่อกลางผนังในโถงแห่งนาม"
dialog_complete = "โอดิน... เจ้าเห็นแล้วสินะ\n\nข้าเฝ้ากำแพงหันผิดข้างมาสามร้อยปี ทั้งโลกก็หันผิดข้างเหมือนกัน — ทุกคนแหงนหาโอดินบนฟ้า ทั้งที่เขาอยู่ข้างล่างนี้มาตลอด\n\nเอาเกราะกระดูกนี่ไป"
objectives = Array[ExtResource("2_obj")]([SubResource("Obj_0"), SubResource("Obj_1")])
kill_monster_id = &""
required_level = 88
required_quests = Array[StringName]([&"c6_3_leave_your_name"])
set_flag_on_complete = &"c6_5_done"
reward_item_id = &"bone_armor"
reward_item_count = 1
reward_zeny = 3764
reward_exp = 22587
reward_job_exp = 15810
