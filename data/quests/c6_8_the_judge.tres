[resource]
script = ExtResource("1_quest")
id = &"c6_8_the_judge"
title = "ผู้พิพากษา"
description = "ล้มผู้พิพากษาผู้ตายที่นาสตรอนด์"
giver_name = "เฮล ผู้ปกครองผู้ตาย"
dialog_offer = "ที่นาสตรอนด์ ฝั่งศพ มีนักบวชผีคนหนึ่งที่ยังตัดสินคนตายตามพงศาวดาร — ใครพูดไม่ตรงกับหนังสือ เขาจะส่งลงไปใต้ราก\n\nข้าไม่ตัดสินใคร มนุษย์ แต่เขาตั้งตัวเป็นผู้ตัดสินแทนข้า ไปหยุดเขาเสีย"
dialog_progress = "ผู้พิพากษาผู้ตายอยู่สุดทางนาสตรอนด์ ระวัง «คำพิพากษา» — วงแสงจะตกลงมาจากข้างบนสามจุด เห็นวงเมื่อไหร่ให้ออกจากวง"
dialog_complete = "ตอนตาย เขาเอ่ยชื่อเจ้า... ชื่อที่เจ้าทิ้งไว้ที่สะพาน\n\nยังมีคนจำชื่อเจ้าได้ มนุษย์ แม้เจ้าจะทิ้งมันไปแล้ว\n\nเอาโล่ของเขาไป — ด้านหลังมีตราที่ถูกขูดออก ตราเดียวกับที่ถูกขูดไปทุกที่ที่เจ้าเคยเห็น"
objectives = Array[ExtResource("2_obj")]([SubResource("Obj_0")])
kill_monster_id = &""
required_level = 93
required_quests = Array[StringName]([&"c6_6_name_beside_odin"])
set_flag_on_complete = &"c6_8_done"
reward_item_id = &"judge_shield"
reward_item_count = 1
