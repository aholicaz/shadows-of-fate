[ext_resource type="Script" path="res://scripts/resources/objective_data.gd" id="o"]
[sub_resource type="Resource" id="o0"]
script = ExtResource("o")
kind = 4
target = &"c7_refuge_marker"
count = 1
text = "ตรวจดูป้ายผู้ลี้ภัย"

[resource]
script = ExtResource("s")
id = &"c7_1_refuge"
title = "เมืองที่รับชื่อ"
description = "อ่านป้ายผู้ลี้ภัยริมทางข้ามเถ้า"
giver_name = "สวาลา ผู้เก็บชื่อ"
dialog_offer = "ยินดีต้อนรับสู่อัมเบอร์เฮเวน เมืองของคนที่หนีคำสั่งของค้อนมา\n\nตามทางข้ามเถ้ามีป้ายที่พวกเราปักไว้ มันคือคำสัญญาของเมืองนี้ ไปอ่านให้จบ แล้วค่อยตัดสินเองว่าที่นี่ต่างจากวิหารของเจ้าอย่างไร"
dialog_progress = "ป้ายอยู่ริมทางข้ามเถ้า ทางที่เจ้าเดินมาจากบัลลังก์ว่าง"
dialog_complete = "ป้ายนั่นบอกว่าที่นี่เราไม่ลบชื่อใคร...\n\nว่าแต่ เศษบัลลังก์ที่เจ้าพกมา มันร้อนขึ้นตอนอยู่ใกล้เตาหลอมใช่ไหม บรินยา ช่างของเรา น่าจะรู้ว่าทำไม ไปหานางดูสิ"
required_level = 96
required_flag = &"chapter6_done"
required_quests = Array[StringName]([])
objectives = Array[ExtResource("o")]([SubResource("o0")])
set_flag_on_complete = &"c7_step_1"
reward_exp = 19515
reward_job_exp = 2230
reward_zeny = 3345
reward_item_id = &""
