[resource]
script = ExtResource("s")
id = &"c7_2_warmth"
title = "ความร้อนที่เก็บไว้"
description = "หาเขี้ยวเก็บความร้อน 3 ชิ้นจากสุนัขเถ้าถ่าน ให้ลีฟทำถุงประคบ"
giver_name = "ลีฟ ผู้รักษาแผลไฟ"
dialog_offer = "ผู้ลี้ภัยที่หนีมาจากฝั่งหมอกยังตัวสั่นไม่หยุด ความหนาวของนิฟล์เฮมยังติดอยู่ในกระดูกพวกเขา\n\nเขี้ยวของสุนัขเถ้าถ่านเก็บความร้อนได้นาน หามาให้ข้าสัก 3 ชิ้น ข้าจะทำเป็นถุงประคบให้พวกเขา — ไม่ได้เอาไปทำอาวุธหรอก"
dialog_progress = "เขี้ยวเก็บความร้อน 3 ชิ้น ล่าได้จากสุนัขเถ้าถ่าน"
dialog_complete = "พวกเขาหลับได้แล้ว...\n\nคำสั่งที่บังคับให้คนทนทุกอย่างโดยไม่บ่น มันไม่ใช่ความเข้มแข็งหรอก มันคือโซ่อีกเส้นหนึ่ง"
required_level = 96
required_flag = &"chapter6_done"
required_quests = Array[StringName]([&"c7_1_refuge"])
objectives = Array[ExtResource("o")]([SubResource("o0")])
set_flag_on_complete = &"c7_step_2"
reward_exp = 31225
reward_job_exp = 3469
reward_zeny = 5204
