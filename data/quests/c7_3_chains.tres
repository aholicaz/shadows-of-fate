[resource]
script = ExtResource("s")
id = &"c7_3_chains"
title = "โซ่ที่ไม่รู้ชื่อ"
description = "หยุดยักษ์แบกโซ่ 5 ตนที่เหมืองโซ่คำสั่ง แล้วตรวจตราคำสั่งบนโซ่"
giver_name = "บรินยา ช่างปลดพันธะ"
dialog_offer = "ที่เหมืองโซ่คำสั่งมียักษ์ที่ถูกล่ามไว้ทำงาน โซ่พวกนั้นไม่ได้ล่ามแค่แขน มันล่ามความคิดด้วย — ตราค้อนบนโซ่สั่งให้พวกเขาทำงานจนตาย\n\nข้าอยากช่วยพวกเขา แต่ต้องเห็นตราคำสั่งกับตาก่อน ถึงจะรู้วิธีแยกคำสั่งออกจากชื่อของคนที่แบกมัน หยุดยักษ์ที่คลั่งพวกนั้น แล้วตรวจตราบนโซ่มาให้ข้า"
dialog_progress = "หยุดยักษ์แบกโซ่ 5 ตน · ตรวจตราคำสั่งบนโซ่ที่เหมือง"
dialog_complete = "คำสั่งกับชื่อถูกสลักเป็นคนละรอย ไฟของข้าแยกมันออกจากกันได้\n\nแต่คนที่จะฟันเส้นสุดท้าย ต้องเป็นคนที่รู้แน่ว่าตัวเองเป็นใคร — คนที่เคยทิ้งชื่อ แล้วเลือกเอามันคืนมาเอง อย่างเจ้า"
required_level = 96
required_flag = &"chapter6_done"
required_quests = Array[StringName]([&"c7_2_warmth"])
objectives = Array[ExtResource("o")]([SubResource("o0"), SubResource("o1")])
set_flag_on_complete = &"c7_step_3"
reward_exp = 31225
reward_job_exp = 3406
reward_zeny = 5109
reward_item_id = &""
