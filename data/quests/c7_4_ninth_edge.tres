[gd_resource type="Resource" script_class="QuestData" format=3]
[ext_resource type="Script" path="res://scripts/resources/quest_data.gd" id="s"]
[ext_resource type="Script" path="res://scripts/resources/objective_data.gd" id="o"]
[sub_resource type="Resource" id="o0"]
script = ExtResource("o")
kind = 0
target = &"kiln_sentinel"
count = 1
text = "ผ่านการทดสอบผู้เฝ้าทั่งว่าง"
[sub_resource type="Resource" id="o1"]
script = ExtResource("o")
kind = 4
target = &"c7_unwritten_anvil"
count = 1
text = "ตรวจดูทั่งที่ไม่รับคำสั่ง หลังล้มผู้เฝ้า"

[resource]
script = ExtResource("s")
id = &"c7_4_ninth_edge"
title = "คมที่เลือกเอง"
description = "(สำหรับ Runeblade) ไปที่เตาหลอมไร้คำสั่ง ล้มผู้เฝ้าทั่งว่าง แล้วตรวจทั่งเพื่อทำพิธีเปลี่ยนอาชีพเป็น Ninth Edge"
giver_name = "บรินยา ช่างปลดพันธะ"
dialog_offer = "ดาบรูนของเจ้ายังมีคำสั่งเก่าฝังอยู่ — ตราค้อนที่ผูกทุกอย่างในโลกนี้ไว้ ถ้าไม่เผามันออก เจ้าจะเติบโตได้แค่เท่าที่ค้อนอนุญาต\n\nมาพบข้าที่เตาหลอมไร้คำสั่ง ผ่านผู้เฝ้าทั่งให้ได้ แล้ววางดาบลงบนทั่ง ไฟจะเผาคำสั่งออกไป แต่คนที่ตัดพันธะเส้นสุดท้ายต้องเป็นเจ้าเอง"
dialog_progress = "ล้มผู้เฝ้าทั่งว่างที่เตาหลอมไร้คำสั่ง แล้วตรวจทั่งที่ไม่รับคำสั่ง (ต้องเป็นอาชีพ Runeblade)"
dialog_complete = "ชื่อของเจ้าไม่ใช่สิ่งที่ผู้ถือค้อนประทานให้ จงถือคมที่เก้าด้วยการเลือกของเจ้าเอง\n\nตั้งแต่นี้เจ้าคือ «คมที่เก้า» — Ninth Edge ขีดจำกัดเก่าที่ค้อนเคยตั้งไว้ ไม่ผูกการเติบโตของเจ้าอีกต่อไป"
required_level = 96
required_flag = &"chapter6_done"
required_quests = Array[StringName]([&"c7_3_chains"])
objectives = Array[ExtResource("o")]([SubResource("o0"), SubResource("o1")])
set_flag_on_complete = &"chapter7_ninth_awakened"
reward_exp = 39031
reward_job_exp = 2927
reward_zeny = 5122
reward_item_id = &"unbound_blade"
required_job = &"runeblade"
reward_job = &"ninth_edge"
reward_job_map = &"unwritten_forge"
