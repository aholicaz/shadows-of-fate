script = ExtResource("s")
id = &"c7_5_chosen_cut"
title = "คมที่ไม่ลบคน"
description = "เรียนคมตัดพันธะหรือเงานามก่อนออกไป เงาของเจ้าต้องตามการตัดสินใจ ไม่ใช่คำสั่งของดาบ ลองกับอัศวินที่ยังเดินตามคำสั่งสุดท้าย"
