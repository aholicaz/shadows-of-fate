[resource]
script = ExtResource("s")
id = &"c7_5_chosen_cut"
title = "คมที่ไม่ลบคน"
description = "ใช้คมตัดพันธะหรือเงานามร่วมคม โจมตีอัศวินคำสั่งสุดท้ายที่ทางขบวนเถ้า"
giver_name = "บรินยา ช่างปลดพันธะ"
dialog_offer = "ไปลองคมใหม่ของเจ้าที่ทางขบวนเถ้า ที่นั่นมีอัศวินที่ยังเดินตามคำสั่งสุดท้ายไม่หยุด ทั้งที่ตัวเองตายไปนานแล้ว\n\nใช้คมตัดพันธะหรือเงานามร่วมคมฟันพวกเขา — คมของเจ้าต้องตัดคำสั่ง ไม่ใช่ตัดคน"
dialog_progress = "ใช้คมตัดพันธะหรือเงานามร่วมคมโจมตีอัศวิน 3 ครั้ง · หยุดอัศวินคำสั่งสุดท้าย 5 ตน"
dialog_complete = "เห็นไหม คมของเจ้าตัดสิ่งที่บังคับพวกเขาได้ โดยไม่ต้องลบว่าพวกเขาเคยเป็นใคร\n\nจำความรู้สึกนั้นไว้ ตอนที่เจ้ายืนอยู่ต่อหน้าผู้คุม"
required_level = 96
required_flag = &"chapter6_done"
required_quests = Array[StringName]([&"c7_4_ninth_edge"])
objectives = Array[ExtResource("o")]([SubResource("o0"), SubResource("o1")])
set_flag_on_complete = &"c7_step_5"
reward_exp = 31225
reward_job_exp = 657
reward_zeny = 3944
reward_item_id = &""
required_job = &"ninth_edge"
