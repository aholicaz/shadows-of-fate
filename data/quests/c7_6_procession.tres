dialog_progress = "หาเลนส์อ่านเถ้า 3 ชิ้น · อ่านคำสั่งสุดท้าย"
dialog_complete = "อีกหนึ่งชั้น... ซ้ำหนึ่งร้อยครั้ง มันไม่ใช่ทางขึ้นสวรรค์ มันคือระบบส่งชื่อ เราต้องเอาทะเบียนจากเบ้าหลอม"
