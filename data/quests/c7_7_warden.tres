[resource]
script = ExtResource("s")
id = &"c7_7_warden"
title = "สิทธิ์ที่จะหยุด"
description = "ผู้คุมจะสั่งให้เจ้าคุกเข่า ดูวงเตือนบนพื้นแล้วออกจากระยะ ก่อนใช้รูนที่สะสมไว้ตัดมัน เจ้าไม่จำเป็นต้องยืนรับทุกคำสั่ง"
giver_name = "บรินยา ช่างปลดพันธะ"
dialog_offer = "ผู้คุมจะสั่งให้เจ้าคุกเข่า ดูวงเตือนบนพื้นแล้วออกจากระยะ ก่อนใช้รูนที่สะสมไว้ตัดมัน เจ้าไม่จำเป็นต้องยืนรับทุกคำสั่ง"
dialog_progress = "ล้มผู้คุมเบ้าหลอมคำสาบาน"
dialog_complete = "เบ้าหลอมหยุดแล้ว ผู้คนในขบวนได้พักเป็นครั้งแรก จงกลับไปอ่านทะเบียนที่อยู่หลังผู้คุม"
required_level = 96
required_flag = &"chapter6_done"
required_quests = Array[StringName]([&"c7_6_procession"])
objectives = Array[ExtResource("o")]([SubResource("o0")])
set_flag_on_complete = &"c7_step_7"
