[resource]
script = ExtResource("s")
id = &"c7_7_warden"
title = "สิทธิ์ที่จะหยุด"
description = "ล้มผู้คุมเบ้าหลอมคำสาบาน"
giver_name = "บรินยา ช่างปลดพันธะ"
dialog_offer = "ผู้คุมเบ้าหลอมคำสาบานจะสั่งให้เจ้าคุกเข่า — และร่างกายเจ้าจะอยากทำตาม\n\nดูวงเตือนบนพื้นให้ดี ถอยออกจากวงก่อนคำสั่งจะลง แล้วค่อยใช้รูนที่สะสมไว้ฟันมัน เจ้าไม่จำเป็นต้องยืนรับทุกคำสั่งหรอก"
dialog_progress = "ผู้คุมอยู่ที่เบ้าหลอมคำสาบาน เห็นวงบนพื้นเมื่อไหร่ ให้ออกจากวงก่อน"
dialog_complete = "เบ้าหลอมหยุดแล้ว คนในขบวนได้พักเป็นครั้งแรก\n\nทะเบียนอยู่หลังที่ที่ผู้คุมเคยยืน สวาลาอยากได้ชื่อในนั้น ไปอ่านมันก่อนที่ไฟจะไหม้หมด"
required_level = 96
required_flag = &"chapter6_done"
required_quests = Array[StringName]([&"c7_6_procession"])
objectives = Array[ExtResource("o")]([SubResource("o0")])
set_flag_on_complete = &"c7_step_7"
reward_exp = 39031
reward_job_exp = 1092
reward_zeny = 4683
reward_item_id = &""
required_job = &"ninth_edge"
