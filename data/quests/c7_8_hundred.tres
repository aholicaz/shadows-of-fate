[ext_resource type="Script" path="res://scripts/resources/objective_data.gd" id="o"]
[sub_resource type="Resource" id="o0"]
script = ExtResource("o")
kind = 4
target = &"c7_tower_register"
count = 1
text = "ตรวจดูทะเบียนหอร้อยชั้น หลังผู้คุมพ่ายแพ้"

[resource]
script = ExtResource("s")
id = &"c7_8_hundred"
title = "หนึ่งร้อยชื่อที่ยังมีชีวิต"
description = "อ่านทะเบียนหอร้อยชั้นหลังเบ้าหลอมคำสาบาน (หลังล้มผู้คุม)"
giver_name = "สวาลา ผู้เก็บชื่อ"
dialog_offer = "ข้าไม่ได้อยากให้เจ้าทำลายทะเบียนนั่น ข้าอยากได้ชื่อของคนในนั้น\n\nทุกชื่อคือคนที่ถูกส่งขึ้นหอ และครอบครัวของพวกเขายังรออยู่ที่เมืองนี้ ไปอ่านทะเบียนหลังเบ้าหลอม แล้วจำชื่อพวกนั้นกลับมาให้ข้า"
dialog_progress = "ทะเบียนอยู่หลังจุดที่ผู้คุมเบ้าหลอมเคยยืน"
dialog_complete = "หอร้อยชั้น... และทุกชื่อในทะเบียนยังมีชีวิตอยู่บนนั้น\n\nเราจะเตรียมทางขึ้นให้รอบคอบ ต่อจากนี้เราจะเดินตามผังนี้ ไม่ใช่ตามคำสั่งของผู้ถือค้อน"
required_level = 96
required_flag = &"chapter6_done"
required_quests = Array[StringName]([&"c7_7_warden"])
objectives = Array[ExtResource("o")]([SubResource("o0")])
set_flag_on_complete = &"chapter7_done"
reward_exp = 39031
reward_job_exp = 696
reward_zeny = 4600
reward_item_id = &"tower_route_fragment"
required_job = &"ninth_edge"
