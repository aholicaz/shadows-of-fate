[gd_resource type="Resource" script_class="QuestData" format=3]
[ext_resource type="Script" path="res://scripts/resources/quest_data.gd" id="s"]
[ext_resource type="Script" path="res://scripts/resources/objective_data.gd" id="o"]
[sub_resource type="Resource" id="goal"]
script = ExtResource("o")
kind = 5
target = &"c8_floor_50_clear"
count = 1
text = "ผ่านชั้น 50 และกลับรายงานสวาลา"
[resource]
script = ExtResource("s")
id = &"c8_10_dawn"
title = "ห้าสิบชั้นสู่รุ่งอรุณ"
description = "ขึ้นหออิกดราซิลจนผ่านชั้น 50 (ผู้คุม: ออโรรา ผู้พิทักษ์มงกุฎ) แล้วกลับมาหาสวาลา"
giver_name = "สวาลา ผู้เก็บชื่อ"
dialog_offer = "ออโรรา ผู้พิทักษ์มงกุฎ รออยู่ที่ชั้น 50 เธอไม่ใช่ศัตรูเสียทีเดียว เธอแค่อยากรู้ว่าคนที่ถือคมที่เก้าจะปกป้องผู้คนได้จริงหรือเปล่า\n\nขึ้นไปให้ถึงชั้น 50 ผ่านบททดสอบของเธอ แล้วกลับมาหาข้า"
dialog_progress = "ขึ้นหอไปให้ถึงชั้น 50 แล้วกลับมาหาข้า — เลือกชั้นเริ่มได้ที่ศิลาราก"
dialog_complete = "คนที่ติดค้างอยู่บนหอได้กลับบ้านแล้ว... ขอบใจนะ\n\nแต่คนที่ออกคำสั่งพวกนี้ตั้งแต่แรก ยังนั่งอยู่เหนือหอขึ้นไปอีก เรื่องนี้ยังไม่จบ"
required_flag = &"chapter7_done"
required_quests = Array[StringName]([&"c8_9_void"])
objectives = Array[ExtResource("o")]([SubResource("goal")])
reward_exp = 200000
reward_job_exp = 28000
reward_zeny = 80000
set_flag_on_complete = &"c8_ascent50_reported"
