[gd_resource type="Resource" script_class="QuestData" format=3]
[ext_resource type="Script" path="res://scripts/resources/quest_data.gd" id="s"]
[ext_resource type="Script" path="res://scripts/resources/objective_data.gd" id="o"]
[sub_resource type="Resource" id="goal"]
script = ExtResource("o")
kind = 5
target = &"c8_floor_55_clear"
count = 1
text = "ผ่านชั้น 55 และกลับรายงานสวาลา"
[resource]
script = ExtResource("s")
id = &"c8_11_thunder"
title = "กลองเหนือเมฆ"
description = "ขึ้นหออิกดราซิลจนผ่านชั้น 55 (ผู้คุม: บรอนน์ ผู้ป่าวประกาศอสุนี) แล้วกลับมาหาสวาลา"
giver_name = "สวาลา ผู้เก็บชื่อ"
dialog_offer = "ได้ยินเสียงนั่นไหม... ฟ้าร้องเหนือชั้น 50 ไม่ได้มาจากพายุ มันคือเสียงกลอง\n\nบรอนน์ ผู้ป่าวประกาศอสุนี ตีกลองส่งคำสั่งของผู้ถือค้อนลงมาตามลำต้น ทุกครั้งที่กลองดัง ผู้คนข้างล่างก็คุกเข่าโดยไม่รู้ตัว ขึ้นไปให้ถึงชั้น 55 แล้วทำให้กลองนั่นเงียบ"
dialog_progress = "ขึ้นหอไปให้ถึงชั้น 55 แล้วกลับมาหาข้า — เลือกชั้นเริ่มได้ที่ศิลาราก"
dialog_complete = "กลองเงียบแล้ว... เมื่อคืนเป็นคืนแรกที่คนในเมืองนอนหลับโดยไม่สะดุ้งตื่นเพราะฟ้าร้อง\n\nบรอนน์ไม่ได้ตีกลองเพราะอยาก เขาถูกผูกไว้กับมันเหมือนคนอื่น ๆ บนหอนี้"
required_flag = &"chapter7_done"
required_quests = Array[StringName]([&"c8_10_dawn"])
objectives = Array[ExtResource("o")]([SubResource("goal")])
reward_exp = 230000
reward_job_exp = 30000
reward_zeny = 85000
