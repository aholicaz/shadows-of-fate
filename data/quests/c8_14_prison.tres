[gd_resource type="Resource" script_class="QuestData" format=3]
[ext_resource type="Script" path="res://scripts/resources/quest_data.gd" id="s"]
[ext_resource type="Script" path="res://scripts/resources/objective_data.gd" id="o"]
[sub_resource type="Resource" id="goal"]
script = ExtResource("o")
kind = 5
target = &"c8_floor_70_clear"
count = 1
text = "ผ่านชั้น 70 และกลับรายงานสวาลา"
[resource]
script = ExtResource("s")
id = &"c8_14_prison"
title = "คุกของเทพที่ถูกลืม"
description = "ขึ้นหออิกดราซิลจนผ่านชั้น 70 (ผู้คุม: กริมนีร์ ผู้คุมเทพที่ถูกลืม) แล้วกลับมาหาสวาลา"
giver_name = "สวาลา ผู้เก็บชื่อ"
dialog_offer = "ชื่อบางชื่อในทะเบียนไม่ใช่ชื่อคน ข้าเพิ่งอ่านออก — มันเป็นชื่อเทพ เทพของวานีร์ของยักษ์ และของพวกที่ไม่มีใครเขียนถึงอีกแล้ว\n\nพงศาวดารบอกว่าพวกเขาตายไปในสงคราม แต่ชั้น 66 ถึง 70 คือคุก และกริมนีร์คือผู้คุม ขึ้นไปดูว่าใครยังถูกขังอยู่"
dialog_progress = "ขึ้นหอไปให้ถึงชั้น 70 แล้วกลับมาหาข้า — เลือกชั้นเริ่มได้ที่ศิลาราก"
dialog_complete = "พวกเขาไม่ได้ตาย... ถูกลืมแค่นั้นเอง และการถูกลืมบนหอนี้ก็คือการถูกขังตลอดกาล\n\nเทพองค์หนึ่งฝากคำมาถึงเจ้า «คนที่เขียนประวัติศาสตร์ไม่เคยแพ้สงคราม» ข้ายังไม่อยากเชื่อว่าเขาหมายถึงใคร"
required_flag = &"chapter7_done"
required_quests = Array[StringName]([&"c8_13_bridge"])
objectives = Array[ExtResource("o")]([SubResource("goal")])
reward_exp = 320000
reward_job_exp = 36000
reward_zeny = 100000
