[gd_resource type="Resource" script_class="QuestData" format=3]
[ext_resource type="Script" path="res://scripts/resources/quest_data.gd" id="s"]
[ext_resource type="Script" path="res://scripts/resources/objective_data.gd" id="o"]
[sub_resource type="Resource" id="goal"]
script = ExtResource("o")
kind = 5
target = &"c8_floor_90_clear"
count = 1
text = "ผ่านชั้น 90 และกลับรายงานสวาลา"
[resource]
script = ExtResource("s")
id = &"c8_18_roots"
title = "รากที่ถูกกัดจากข้างใน"
description = "ขึ้นหออิกดราซิลจนผ่านชั้น 90 (ผู้คุม: เนียด ผู้แทะรากบัลลังก์) แล้วกลับมาหาสวาลา"
giver_name = "สวาลา ผู้เก็บชื่อ"
dialog_offer = "บ่อน้ำที่วานาเฮมแห้ง ไฟรากของช่างวานาเฮมอ่อนลงทุกปี ต้นไม้ให้ผลน้อยลงทุกที่ — เจ้าเห็นมาตลอดทาง\n\nมันไม่ใช่เพราะโลกแก่ มีบางอย่างกัดรากอิกดราซิลจากใต้บัลลังก์บนยอดหอ เนียดเฝ้าอยู่ที่ชั้น 90 ไปดูให้เห็นกับตาว่ามันกินรากเพื่อใคร"
dialog_progress = "ขึ้นหอไปให้ถึงชั้น 90 แล้วกลับมาหาข้า — เลือกชั้นเริ่มได้ที่ศิลาราก"
dialog_complete = "รูน «ดูด» บนหัวค้อนที่คนแคระถูกสั่งให้สลัก... มันไม่ได้ดูดแค่คนถือ ทุกคำอธิษฐานที่ผู้คนส่งถึงธอร์ ไหลผ่านรากขึ้นไปเลี้ยงบัลลังก์ ต้นไม้ไม่ได้แก่... มันกำลังถูกดูดจนแห้ง\n\nเราถูกสอนให้ขอบคุณธอร์ที่ให้ฝนตก แต่ฝนที่ตกลงมา เป็นแค่เศษที่เหลือจากสิ่งที่เขาเอาไป"
required_flag = &"chapter7_done"
required_quests = Array[StringName]([&"c8_17_chronicle"])
objectives = Array[ExtResource("o")]([SubResource("goal")])
reward_exp = 460000
reward_job_exp = 44000
reward_zeny = 120000
