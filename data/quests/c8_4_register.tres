[gd_resource type="Resource" script_class="QuestData" format=3]
[ext_resource type="Script" path="res://scripts/resources/quest_data.gd" id="s"]
[ext_resource type="Script" path="res://scripts/resources/objective_data.gd" id="o"]
[sub_resource type="Resource" id="goal"]
script = ExtResource("o")
kind = 5
target = &"c8_floor_20_clear"
count = 1
text = "ผ่านชั้น 20 และกลับหาสวาลา"
[resource]
script = ExtResource("s")
id = &"c8_4_register"
title = "ยี่สิบชั้นเหนือคำสั่ง"
description = "ขึ้นหออิกดราซิลจนผ่านชั้น 20 (ผู้คุม: นามสูญ ผู้กลืนทะเบียน) แล้วกลับมาหาสวาลา"
giver_name = "สวาลา ผู้เก็บชื่อ"
dialog_offer = "ที่ชั้น 20 มีสิ่งที่กินชื่อเป็นอาหาร — นามสูญ ผู้กลืนทะเบียน ทุกชื่อที่ถูกส่งขึ้นหอ มันกลืนลงไปทีละชื่อ\n\nล้มมันให้ได้ แล้วเราจะได้รายชื่อกับเส้นทางช่วงแรกกลับคืนมา"
dialog_progress = "ขึ้นหอไปให้ถึงชั้น 20 แล้วกลับมาหาข้า — เลือกชั้นเริ่มได้ที่ศิลาราก"
dialog_complete = "เราได้เส้นทางแรกและรายชื่อกลับมาแล้ว... พักให้พร้อมก่อน กิ่งถัดไปสูงกว่านี้มาก"
required_flag = &"chapter7_done"
required_quests = Array[StringName]([&"c8_3_reflections"])
objectives = Array[ExtResource("o")]([SubResource("goal")])
reward_exp = 39026
reward_job_exp = 1387
reward_zeny = 4336
set_flag_on_complete = &"c8_4_register_done"
