[gd_resource type="Resource" script_class="QuestData" format=3]
[ext_resource type="Script" path="res://scripts/resources/quest_data.gd" id="s"]
[ext_resource type="Script" path="res://scripts/resources/objective_data.gd" id="o"]
[sub_resource type="Resource" id="goal"]
script = ExtResource("o")
kind = 5
target = &"c8_floor_25_clear"
count = 1
text = "ผ่านชั้น 25 และกลับรายงานสวาลา"
[resource]
script = ExtResource("s")
id = &"c8_5_hours"
title = "ชั่วโมงของผู้ติดค้าง"
description = "ขึ้นหออิกดราซิลจนผ่านชั้น 25 (ผู้คุม: โฮรา ผู้คุมชั่วโมง) แล้วกลับมาหาสวาลา"
giver_name = "สวาลา ผู้เก็บชื่อ"
dialog_offer = "เหนือชั้น 20 ขึ้นไป เวลาเดินไม่เหมือนข้างล่าง โฮรา ผู้คุมชั่วโมง หยุดเวลาไว้เพื่อไม่ให้คนที่ติดอยู่บนกิ่งตาย — แต่ก็ทำให้พวกเขาไปไหนไม่ได้เช่นกัน\n\nขึ้นไปถึงชั้น 25 คลายวงนาฬิกาของมันให้ได้ แต่ระวังอย่าให้ทางกลับพังตามไปด้วย"
dialog_progress = "ขึ้นหอไปให้ถึงชั้น 25 แล้วกลับมาหาข้า — เลือกชั้นเริ่มได้ที่ศิลาราก"
dialog_complete = "เวลาเริ่มเดินอีกครั้ง... พร้อมกับทางกลับบ้านของพวกเขา"
required_flag = &"chapter7_done"
required_quests = Array[StringName]([&"c8_4_register"])
objectives = Array[ExtResource("o")]([SubResource("goal")])
reward_exp = 100000
reward_job_exp = 18000
reward_zeny = 55000
set_flag_on_complete = &"c8_5_hours_done"
