[gd_resource type="Resource" script_class="QuestData" format=3]
[ext_resource type="Script" path="res://scripts/resources/quest_data.gd" id="s"]
[ext_resource type="Script" path="res://scripts/resources/objective_data.gd" id="o"]
[sub_resource type="Resource" id="goal"]
script = ExtResource("o")
kind = 5
target = &"c8_floor_30_clear"
count = 1
text = "ผ่านชั้น 30 และกลับรายงานสวาลา"
[resource]
script = ExtResource("s")
id = &"c8_6_tide"
title = "เสียงเรียกข้ามจันทร์"
description = "ขึ้นหออิกดราซิลจนผ่านชั้น 30 (ผู้คุม: เซเลน ผู้พยากรณ์กระแสจันทร์) แล้วกลับมาหาสวาลา"
giver_name = "สวาลา ผู้เก็บชื่อ"
dialog_offer = "ชั้น 26 ถึง 30 เป็นบึงใต้แสงจันทร์ เซเลน ผู้พยากรณ์กระแสจันทร์ เก็บเสียงของคนที่ติดอยู่ไว้ในน้ำ ไม่ให้ลงมาถึงเรา\n\nเปิดทางผ่านชั้น 30 ให้เสียงพวกนั้นไหลลงมาถึงครอบครัวที่รออยู่ข้างล่าง"
dialog_progress = "ขึ้นหอไปให้ถึงชั้น 30 แล้วกลับมาหาข้า — เลือกชั้นเริ่มได้ที่ศิลาราก"
dialog_complete = "คนข้างล่างเริ่มได้ยินเสียงตอบกลับแล้ว... เราไม่ได้ปีนขึ้นไปลำพังอีกต่อไป"
required_flag = &"chapter7_done"
required_quests = Array[StringName]([&"c8_5_hours"])
objectives = Array[ExtResource("o")]([SubResource("goal")])
reward_exp = 120000
reward_job_exp = 20000
reward_zeny = 60000
set_flag_on_complete = &"c8_6_tide_done"
