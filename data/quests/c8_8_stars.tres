[gd_resource type="Resource" script_class="QuestData" format=3]
[ext_resource type="Script" path="res://scripts/resources/quest_data.gd" id="s"]
[ext_resource type="Script" path="res://scripts/resources/objective_data.gd" id="o"]
[sub_resource type="Resource" id="goal"]
script = ExtResource("o")
kind = 5
target = &"c8_floor_40_clear"
count = 1
text = "ผ่านชั้น 40 และกลับรายงานสวาลา"
[resource]
script = ExtResource("s")
id = &"c8_8_stars"
title = "ชื่อใต้หมู่ดาว"
description = "ขึ้นหออิกดราซิลจนผ่านชั้น 40 (ผู้คุม: อัสตรา ผู้รักษาดารา) แล้วกลับมาหาสวาลา"
giver_name = "สวาลา ผู้เก็บชื่อ"
dialog_offer = "อัสตรา ผู้รักษาดารา ถือแผนที่ชื่อของทุกคนบนหอ แต่แผนที่นั้นยังขาดไปหลายชื่อ\n\nฝ่าวงโคจรขึ้นไปถึงชั้น 40 แล้วเราจะเทียบแผนที่กับทะเบียนของเรา — ต้องรู้ให้แน่ว่าใครยังรอด"
dialog_progress = "ขึ้นหอไปให้ถึงชั้น 40 แล้วกลับมาหาข้า — เลือกชั้นเริ่มได้ที่ศิลาราก"
dialog_complete = "รายชื่อทั้งสองฝั่งตรงกันแล้ว... แต่ยังมีรอยแยกขวางทางกลับอยู่ข้างบน"
required_flag = &"chapter7_done"
required_quests = Array[StringName]([&"c8_7_sun"])
objectives = Array[ExtResource("o")]([SubResource("goal")])
reward_exp = 160000
reward_job_exp = 24000
reward_zeny = 70000
set_flag_on_complete = &"c8_8_stars_done"
