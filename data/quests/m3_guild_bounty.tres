[gd_resource type="Resource" script_class="QuestData" load_steps=4 format=3]

[ext_resource type="Script" path="res://scripts/resources/quest_data.gd" id="1_quest"]
[ext_resource type="Script" path="res://scripts/resources/objective_data.gd" id="2_obj"]

[sub_resource type="Resource" id="Obj_0"]
script = ExtResource("2_obj")
kind = 5
target = &"guild_first_bounty"
count = 1
text = "ส่งใบประกาศล่าของกิลด์ 1 ใบ (คุยกับบียอร์น › เมนู «ใบประกาศล่า»)"

[resource]
script = ExtResource("1_quest")
id = &"m3_guild_bounty"
title = "ใบประกาศใบแรก"
description = "หัวหน้ากิลด์บียอร์นชวนให้ลองงาน «ใบประกาศล่า» ของกิลด์นักผจญภัย — คุยกับบียอร์นแล้วเลือกเมนู «ใบประกาศล่า» รับใบที่ถูกใจ 1 ใบ ทำให้ครบ แล้วเลือก «ส่งงาน» จากนั้นกลับมาฟังเรื่องขั้นกิลด์"
giver_name = "หัวหน้ากิลด์บียอร์น"
dialog_offer = "ฮ่า! เจ้าคือคนที่ล้างทุ่งโพริงให้ฮันส์ใช่ไหม ข่าวไปไวนะ ฝีมือแบบนี้กิลด์ต้องการ

นอกจากงานของชาวเมืองแล้ว กิลด์นักผจญภัยยังติด «ใบประกาศล่า» ไว้ที่บอร์ดทุกเมือง — ล่ามอนตามจำนวน หรือเก็บวัตถุดิบมาส่ง ได้ทั้งซีนี EXP และแร่ตีบวกอย่างฟราคอน บางใบยังแถมยามาให้ด้วย

ส่งใบแล้วบอร์ดจะออกใบใหม่ให้เรื่อย ๆ งานไม่มีวันหมด ลองดูสักใบสิ เลือกเมนู «ใบประกาศล่า» ตอนคุยกับข้า รับใบที่ถูกใจ ทำให้ครบแล้วกลับมาส่ง

ส่งใบแรกได้เมื่อไหร่ กลับมาคุยกับข้า ข้ามีเรื่อง «ขั้นกิลด์» จะเล่าให้ฟัง"
dialog_progress = "ใบประกาศอยู่ในเมนู «ใบประกาศล่า» ตอนคุยกับข้า — รับสักใบ ใบล่าบอกว่าต้องล่าตัวอะไรกี่ตัว ใบเก็บของต้องมีของในกระเป๋าครบ ทำเสร็จแล้วเลือก «ส่งงาน» ที่ใบนั้น"
dialog_complete = "ใบแรกผ่านไปแล้ว! ข้าจดชื่อเจ้าลงสมุดกิลด์เรียบร้อย นี่ของต้อนรับจากกิลด์ — ทีนี้มาฟังเรื่องขั้นกิลด์กันหน่อย"
objectives = Array[ExtResource("2_obj")]([SubResource("Obj_0")])
kill_monster_id = &""
required_level = 3
required_quests = Array[StringName]([&"hans_poring"])
cutscene_pan_npc = "หัวหน้ากิลด์บียอร์น"
cutscene_text = "ทุกใบประกาศที่ส่งสำเร็จ เจ้าจะได้ «แต้มกิลด์» — ใบล่ามอนกับใบเก็บวัตถุดิบได้ใบละ 1 แต้ม ใบล่าบอสได้ 3 แต้ม แต้มนับรวมทุกเมือง จะส่งที่บอร์ดไหนก็ได้

แต้มถึงเมื่อไหร่ ขั้นก็ขยับเมื่อนั้น:
F 0 แต้ม «นักผจญภัยฝึกหัด» · E 20 «นักล่ามือใหม่»
D 50 «นักล่าประจำเมือง» · C 100 «นักล่ามือฉมัง»
B 200 «ผู้พิชิตใบประกาศ» · A 400 «มือล่าชั้นครู»
และสูงสุด S 800 แต้ม «ตำนานแห่งกิลด์» — ทั้งพรอนเทรามีไม่กี่คนที่ไปถึง

ขั้นยิ่งสูง กิลด์ยิ่งดูแล — ร้านค้า ค่าวาร์ป ค่ารักษา ค่าขอพร ค่าตีบวก และค่าย่อยการ์ด ลดราคาให้ตั้งแต่ 3% ที่ขั้น F ไปจนถึง 30% ที่ขั้น S · พรแห่งธอร์ก็อยู่กับเจ้านานขึ้น · และทุกครั้งที่เลื่อนขั้น เจ้าจะได้แต้มสเตตัสฟรีอีก 10 แต้ม

บอร์ดแต่ละเมืองมี 3 ช่อง: ช่องแรกใบล่ามอน ช่องสองล่ามอนหรือเก็บวัตถุดิบ ช่องสามคือ «ใบล่าบอส» ซึ่งกิลด์จะออกให้ก็ต่อเมื่อเจ้าส่งใบธรรมดาของเมืองนั้นครบ 5 ใบ ส่งใบแล้วช่องนั้นจะพักสักครู่ก่อนออกใบใหม่

ทุกเมืองที่เจ้าจะไปถึงมีคนของกิลด์ถือบอร์ดอยู่ อยากดูแต้ม ขั้น และสิทธิ์ของตัวเอง เลือก «สถานะกิลด์» ในเมนูใบประกาศได้ทุกเมื่อ — เอ้า ข้าเปิดสมุดกิลด์ให้ดูเลย"
reward_item_id = &"red_potion"
reward_item_count = 10
reward_zeny = 800
reward_exp = 400
