[resource]
script = ExtResource("1_quest")
id = &"rb11_shadow_of_the_blade"
title = "เงาของดาบ"
description = "เปลี่ยนเป็นร่างจางที่ผลึกใหญ่ท้ายเมือง ล้มเงาสะท้อน 3 ตัว แล้วอ่านศิลาผู้ถูกทิ้งในป่าที่แสงจาง"
giver_name = "ผู้เห็นแสงเอย์ร"
dialog_offer = "เงาสะท้อนในทะเลสาบกระจก... มันคือตัวเจ้า มนุษย์ ตัวเจ้าที่ยืนอยู่อีกฝั่งของแสง\n\nไปแตะผลึกใหญ่ท้ายเมืองเพื่อเปลี่ยนเป็นร่างจาง แล้วไปล้มเงาของเจ้าเองที่ทะเลสาบ 3 ตัว จากนั้นอ่านศิลาในป่าที่แสงจาง — รูนดวงที่เจ็ดซ่อนอยู่ในเงาของชื่อที่ถูกลบ"
dialog_progress = "ต้องอยู่ในร่างจาง (สลับที่ผลึกใหญ่ท้ายเมือง) แล้วล้มเงาสะท้อน 3 ตัว · อ่านศิลาผู้ถูกทิ้ง"
dialog_complete = "«เงา» — รูนดวงที่เจ็ด รูนที่สว่างได้เฉพาะในที่มืด\n\nตอนนี้ดาบเจ้ามีเงาเป็นของตัวเองแล้ว — ท่า «เงานามร่วมคม» ที่ให้เงาดาบฟันตามทุกครั้ง เกิดจากรูนดวงนี้ ใช้ได้ทั้งสายคมและสายหนัก\n\nส่วนดวงที่แปดกับเก้า... อยู่ในที่ที่ไม่มีแสงเลย ที่ที่คนตายพูดได้"
objectives = Array[ExtResource("2_obj")]([SubResource("Obj_0"), SubResource("Obj_1")])
kill_monster_id = &""
required_level = 82
required_job = &"runeblade"
required_quests = Array[StringName]([&"rb10_borrowed_light", &"c5_5_thing_in_the_water"])
required_flag = &"has_shade_crystal"
set_flag_on_complete = &"rb_rune_7"
reward_zeny = 2867
reward_exp = 17206

reward_job_exp = 12044
