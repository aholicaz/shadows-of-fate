[resource]
script = ExtResource("1_quest")
id = &"rb11_shadow_of_the_blade"
title = "RB11 เงาของดาบ"
description = "ล้มเงาสะท้อน 3 ตัวขณะอยู่ในร่างจาง แล้วอ่านศิลาผู้ถูกทิ้ง"
giver_name = "ผู้เห็นแสงเอย์ร"
dialog_offer = "เงาสะท้อนในทะเลสาบ... มันคือเจ้า มนุษย์ เจ้าที่มองอีกด้าน\n\nสลับเป็นร่างจางที่ผลึกใหญ่ แล้วไปล้มเงาของเจ้าเอง 3 ตัว จากนั้นอ่านศิลาในป่าจาง — ดวงที่เจ็ดอยู่ในเงาของชื่อที่ถูกลบ"
dialog_progress = "ต้องอยู่ในร่างจาง (สลับที่ผลึกใหญ่ท้ายเมือง) แล้วล้มเงาสะท้อน 3 · อ่านศิลาผู้ถูกทิ้ง"
dialog_complete = "«เงา» — ดวงที่เจ็ด รูนที่สว่างได้เฉพาะในที่มืด\n\nจากนี้ดาบเจ้ามีเงาของมันเอง — «อักขระคู่» จะสะท้อนเงาได้ชัดขึ้น ใช้ได้ทั้งคมและแรง\nดวงที่แปดกับเก้า... อยู่ในที่ที่ไม่มีแสงเลย ที่ที่คนตายพูดได้"
objectives = Array[ExtResource("2_obj")]([SubResource("Obj_0"), SubResource("Obj_1")])
kill_monster_id = &""
required_level = 82
required_job = &"runeblade"
required_quests = Array[StringName]([&"rb10_borrowed_light", &"c5_5_thing_in_the_water"])
required_flag = &"has_shade_crystal"
set_flag_on_complete = &"rb_rune_7"
reward_zeny = 30000
reward_exp = 180000
