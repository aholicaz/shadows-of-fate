[resource]
script = ExtResource("1_quest")
id = &"rb12_eighth_rune_ash"
title = "รูนดวงที่แปดในเถ้า"
description = "ล่าผีจมน้ำ 15 ตนและผู้ข้ามฝั่ง 5 ตนที่แม่น้ำเกียลล์ และให้เงาดาบจาก «เงานามร่วมคม» โดนศัตรู 20 ครั้ง"
giver_name = "กุลล์ไวก์ (ผี)"
dialog_offer = "ดวงที่แปดคือ «เถ้า» — สิ่งที่เหลืออยู่หลังถูกเผา ข้ารู้จักมันดีกว่าใครในโลกนี้\n\nไปที่แม่น้ำเกียลล์ ใช้เงานามร่วมคมของเจ้า ให้เงาดาบฟันผู้ตายให้ได้ 20 ครั้ง — เงาดาบก็คือเถ้าของการฟันแต่ละครั้ง ระหว่างนั้นจัดการผีจมน้ำกับผู้ข้ามฝั่งไปด้วย"
dialog_progress = "ผีจมน้ำ 15 · ผู้ข้ามฝั่ง 5 · เงาดาบจากเงานามร่วมคมโดนศัตรู 20 ครั้ง"
dialog_complete = "«เถ้า» — รูนดวงที่แปด\n\nเหลืออีกดวงเดียว มนุษย์ และไม่มีใครสลักดวงที่เก้าให้เจ้าได้ เพราะมันคือชื่อของคนที่ถือดาบเอง\n\nไปที่โถงแห่งนาม เมื่อเจ้าทิ้งชื่อไว้ที่สะพานแล้ว และแกร่งพอ (เลเวล 90)"
objectives = Array[ExtResource("2_obj")]([SubResource("Obj_0"), SubResource("Obj_1"), SubResource("Obj_2")])
kill_monster_id = &""
required_level = 88
required_job = &"runeblade"
required_quests = Array[StringName]([&"rb11_shadow_of_the_blade", &"c6_2_fourth_burning"])
set_flag_on_complete = &"rb_rune_8"
reward_zeny = 3613
reward_exp = 22587

reward_job_exp = 15810
