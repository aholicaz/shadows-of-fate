[resource]
script = ExtResource("1_quest")
id = &"rb13_the_ninth_wall"
title = "ผนังที่เก้า"
description = "ในโถงแห่งนาม สลักชื่อของเจ้าเองลงบนผนังว่างด้วยค้อนสลักของเกอร์ด เพื่อรักษาชื่อไว้ก่อนเดินทางสู่เตาหลอมในมุสเปลเฮม"
giver_name = "เฮล ผู้ปกครองผู้ตาย"
dialog_offer = "เจ้าไม่มีชื่อแล้ว... ดี อักขระที่เก้าไม่เคยมีใครสลักได้ เพราะมันคือชื่อของคนที่ถือดาบ\n\nในโถงแห่งนาม ชื่อทุกชื่อถูกลบไปหมด ชื่อเดียวที่ยังสลักใหม่ได้คือชื่อที่ยังไม่เคยถูกใครลบ — ชื่อของเจ้าเอง\n\nจัดการผู้เฝ้านามกับเสียงที่ถูกลบให้โถงสงบก่อน อ่านชื่อโอดิน แล้วไปที่ผนังว่างท้ายโถง ใช้ค้อนสลักที่เกอร์ดให้ไว้"
dialog_progress = "ผู้เฝ้านาม 15 · เสียงที่ถูกลบ 10 · อ่านชื่อโอดิน · สลักชื่อที่ผนังว่างท้ายโถงแห่งนาม (ต้องเลเวล 90 และมีค้อนสลักของเกอร์ด)"
dialog_complete = "ชื่อของเจ้า... ถูกสลักใหม่ ในโถงที่ชื่อทุกชื่อถูกลบ\n\nแต่ชื่อนั้นยังมีพันธะของค้อนผูกอยู่ พาดาบไปที่มุสเปลเฮม ที่นั่นมีไฟที่เผาคำสั่งได้โดยไม่เผาคน ช่างชื่อบรินยาจะช่วยเจ้าตัดพันธะนั้น แล้วเจ้าจะได้ถือคมที่เก้าด้วยการเลือกของตัวเอง"
objectives = Array[ExtResource("2_obj")]([SubResource("Obj_0"), SubResource("Obj_1"), SubResource("Obj_2"), SubResource("Obj_3")])
kill_monster_id = &""
required_level = 90
required_job = &"runeblade"
reward_job = &""
reward_job_map = &"hall_of_names"
required_quests = Array[StringName]([&"rb12_eighth_rune_ash", &"c6_3_leave_your_name", &"c6_5_wrong_side"])
required_flag = &"rb_next_job_hint"
set_flag_on_complete = &"ninth_edge_awakened_q"
reward_item_id = &"name_pendant_eq"
reward_item_count = 1
reward_zeny = 4097
reward_exp = 24584

