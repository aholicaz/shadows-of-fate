[gd_resource type="Resource" script_class="QuestData" load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/resources/quest_data.gd" id="1_quest"]
[ext_resource type="Script" path="res://scripts/resources/objective_data.gd" id="2_obj"]

[sub_resource type="Resource" id="Obj_0"]
script = ExtResource("2_obj")
kind = 0
target = &"false_judge"
count = 1

[sub_resource type="Resource" id="Obj_1"]
script = ExtResource("2_obj")
kind = 6
target = &"false_judge|ninth"
count = 1
text = "สกิล Ninth Edge โดนผู้พิพากษา"

[resource]
script = ExtResource("1_quest")
id = &"rb14_edge_that_remembers"
title = "คมที่จำได้"
description = "หลังเปลี่ยนเป็น Ninth Edge ที่มุสเปลเฮม กลับมาล้มผู้พิพากษาผู้ตายที่นาสตรอนด์ โดยใช้สกิล Ninth Edge โดนเขาอย่างน้อย 1 ครั้ง"
giver_name = "เฮล ผู้ปกครองผู้ตาย"
dialog_offer = "ผู้พิพากษาผู้ตายตัดสินคนตามชื่อในหนังสือ... ลองให้เขาเจอชื่อที่ไม่มีอยู่ในหนังสือเล่มไหนเลยดูสิ — ชื่อที่เจ้าสลักด้วยมือตัวเอง\n\nหลังผ่านพิธีที่มุสเปลเฮมแล้ว กลับมาล้มเขา โดยใช้ท่าของคมที่เก้า — คมตัดพันธะ เงานามร่วมคม หรือประกาศนามที่เก้า — ให้โดนเขาอย่างน้อยหนึ่งครั้ง"
dialog_progress = "ล้มผู้พิพากษาผู้ตายที่นาสตรอนด์ — ต้องมีสกิล Ninth Edge (คมตัดพันธะ · เงานามร่วมคม · ประกาศนามที่เก้า) โดนเขาอย่างน้อย 1 ครั้ง"
dialog_complete = "เขาอ่านชื่อเจ้าออก... ทั้งที่มันไม่มีอยู่ในหนังสือเล่มไหน\n\nคมที่เจ้าเลือกเองผ่านการพิพากษาแล้ว เก็บความรู้สึกนี้ไว้ — วันหนึ่งเจ้าจะต้องยืนต่อหน้าคนที่เขียนคำสั่งทั้งหมดนั้น"
objectives = Array[ExtResource("2_obj")]([SubResource("Obj_0"), SubResource("Obj_1")])
kill_monster_id = &""
required_level = 92
required_job = &"ninth_edge"
required_quests = Array[StringName]([&"rb13_the_ninth_wall"])
set_flag_on_complete = &"ninth_inscription_unlocked"
reward_zeny = 4270
reward_exp = 26688

reward_job_exp = 18681
