[gd_resource type="Resource" script_class="QuestData" load_steps=3 format=3]

[ext_resource type="Script" path="res://scripts/resources/quest_data.gd" id="1_quest"]
[ext_resource type="Script" path="res://scripts/resources/objective_data.gd" id="2_obj"]

[sub_resource type="Resource" id="Obj_0"]
script = ExtResource("2_obj")
kind = 2
target = &"บรอกก์"
count = 1
text = "ให้บรอกก์ได้ยินเสียงรูนของซินดริ"

[resource]
script = ExtResource("1_quest")
id = &"rb15_song_for_brokk"
title = "เสียงที่บรอกก์รอ"
description = "นำดาบรูนที่ร้องได้แล้วไปให้บรอกก์ที่นิดาเวลลิร์ได้ฟัง"
giver_name = "ผู้อาวุโสญอร์ดา"
turn_in_name = "บรอกก์"
dialog_offer = "ก่อนเจ้าจะออกเดินทางไกล... มีคนคนหนึ่งที่ควรได้ยินข่าวนี้ก่อนใคร\n\nบรอกก์รอฟังรูนของซินดริร้องอีกครั้งมานานกว่าที่เจ้าจะนึกออก ไปหาเขาที่นิดาเวลลิร์ ให้เขาได้ยินกับหูตัวเอง"
dialog_progress = "บรอกก์อยู่ที่นิดาเวลลิร์ ใช้เสาวาปไปได้ แล้วชักดาบให้เขาฟัง"
dialog_complete = "...นั่นเสียงรูนของซินดริ ข้าจำเสียงนี้ได้ ข้าได้ยินมันในฝันทุกคืน\n\n(บรอกก์หันหลังให้เจ้า ไหล่ของเขาสั่นอยู่ครู่หนึ่ง)\n\nวันที่พวกนั้นลบชื่อเขา ข้ายืนดูเฉย ๆ ข้ากลัวว่าชื่อของข้าจะหายไปด้วย... ขอบใจ มนุษย์ อย่างน้อยงานชิ้นสุดท้ายของเขาก็ไม่ต้องเงียบไปตลอดกาล"
objectives = Array[ExtResource("2_obj")]([SubResource("Obj_0")])
kill_monster_id = &""
required_level = 50
required_job = &""
required_quests = Array[StringName]([&"rb6_runeblade"])
set_flag_on_complete = &"rb_told_brokk"
reward_zeny = 3000
reward_exp = 6000
reward_job_exp = 4000
