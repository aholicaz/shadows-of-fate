[gd_resource type="Resource" script_class="QuestData" format=3]

[ext_resource type="Script" path="res://scripts/resources/quest_data.gd" id="q"]
[ext_resource type="Script" path="res://scripts/resources/objective_data.gd" id="o"]

[sub_resource type="Resource" id="O0"]
script = ExtResource("o")
kind = 2
target = &"ผู้อาวุโสญอร์ดา"
count = 1
text = "นำชิ้นรูนไร้เสียงไปให้ญอร์ดา"

[resource]
script = ExtResource("q")
id = "rb1_unsung_iron"
title = "สิ่งที่ค้อนมิได้สอน"
giver_name = "บรอกก์"
description = "บรอกก์ฝาก «ชิ้นรูนไร้เสียง» — งานชิ้นสุดท้ายของซินดริ — ให้นำไปหาผู้อาวุโสญอร์ดาที่นครวานาเฮม"
dialog_offer = "...เจ้าเห็นแบบร่างบนกำแพงเตาหลอมแล้ว เห็นรูน «ดูด» บนหัวค้อนแล้ว งั้นข้าจะเล่าส่วนที่แบบร่างไม่ได้บอก\n\nรูนแท้ไม่ได้ดูดอย่างเดียว มันคือสัญญาสองทาง — คนถือให้แรง รูนคืนพลังกลับ ตอนตีค้อนให้ธอร์ เราถูกสั่งให้ขูดเส้นคืนพลังทิ้ง ข้าทำตาม... ซินดริไม่ยอม แล้วชื่อของเขาก็หายไปจากป้ายหลุมศพ\n\nนี่คืองานชิ้นสุดท้ายของซินดริ รูนครบทั้งสองทาง แต่มันเงียบมาตั้งแต่วันที่เขาตาย เอาไปให้ผู้อาวุโสญอร์ดาที่วานาเฮม พวกวานีร์คือคนที่สอนรูนให้เรา ถ้ามีใครทำให้มันร้องได้อีก ก็คือพวกนาง"
dialog_progress = "ญอร์ดาอยู่ที่นครวานาเฮม ไปตามทางสายรากหลังเตาหลอมร้าง... บอกนางว่าชิ้นนี้เป็นของซินดริ นางจะเข้าใจ"
dialog_complete = "(ญอร์ดาพลิกชิ้นรูนในมืออยู่นาน)\n\nลายสลักแบบนี้... ข้าไม่ได้เห็นมาสามร้อยปีแล้ว มันไม่ได้เสียหรอก มนุษย์ มันแค่รอ — รอคนที่จะให้คำสัตย์กับมันด้วยใจตัวเอง ไม่ใช่เพราะมีใครสั่ง"
required_flag = "chapter2_done"
set_flag_on_complete = "rb_iron"
required_level = 1
required_job = &"swordsman"
required_quests = Array[StringName]([&"c2_8_hammer_truth"])
objectives = Array[ExtResource("o")]([SubResource("O0")])
