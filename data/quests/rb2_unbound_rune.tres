[ext_resource type="Script" path="res://scripts/resources/objective_data.gd" id="o"]

[sub_resource type="Resource" id="O0"]
script = ExtResource("o")
kind = 4
target = &"rb_rune_tablet"
count = 1
text = "ตรวจดูศิลาคำสัตย์"

[resource]
script = ExtResource("q")
id = "rb2_unbound_rune"
title = "อักขระที่ปฏิเสธนาย"
giver_name = "ผู้อาวุโสญอร์ดา"
description = "อ่านศิลาคำสัตย์ข้างลานเมืองวานาเฮม — ศิลาที่อัศวินดาบรูนในอดีตจารึกคำสัตย์ไว้"
dialog_offer = "รูนของซินดริไม่ยอมรับใครเป็นนาย มันไม่ฟังยศ ไม่ฟังคำสั่ง... มันฟังแค่คำสัตย์ของคนที่ถือ — แบบเดียวกับดาบของอัศวินดาบรูน\n\nสามร้อยปีก่อน อัศวินดาบรูนคือผู้พิทักษ์บ่อน้ำของเรา พ่อของข้าก็เป็นหนึ่งในนั้น พวกเขาสู้จนคนสุดท้ายในสงคราม แล้วก็ไม่มีใครถือดาบแบบนั้นอีกเลย\n\nไปอ่านศิลาคำสัตย์ข้างลานเมือง ที่ที่พวกเขาจารึกคำสัตย์ก่อนรับดาบ แล้วพกรูนนี้ติดตัวไว้ ถ้ามันจะตื่น มันจะตื่นใกล้ที่ที่พวกเขาล้มลง"
dialog_progress = "ศิลาคำสัตย์อยู่ใกล้ ๆ ข้านี่เอง ข้างลานเมือง"
dialog_complete = "«คมที่ไร้จังหวะย่อมแตกหัก แรงที่ไร้การควบคุมย่อมย้อนคืน» — พ่อข้าท่องประโยคนี้ทุกเช้า\n\nพูดง่าย ๆ คือ ฟันเร็วแต่ไร้จังหวะ ดาบจะหัก ฟันแรงแต่คุมไม่อยู่ แรงนั้นจะย้อนมาทำร้ายตัวเอง จำไว้ให้ดี"
required_flag = ""
set_flag_on_complete = "rb_rune"
required_level = 38
required_job = &"swordsman"
required_quests = Array[StringName]([&"rb1_unsung_iron", &"c3_1_open_gate"])
objectives = Array[ExtResource("o")]([SubResource("O0")])
