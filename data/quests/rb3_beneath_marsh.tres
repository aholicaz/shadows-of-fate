[resource]
script = ExtResource("q")
id = "rb3_beneath_marsh"
title = "เสียงจากใต้บึง"
giver_name = "ผู้อาวุโสญอร์ดา"
description = "ตามเสียงรูนในบึงหมอกเงิน ตรวจ 3 จุด: ศิลารูนแตก · เงาในน้ำ · กระดิ่งใต้ราก"
dialog_offer = "รูนในมือเจ้าเริ่มสั่นแล้วใช่ไหม... ข้าสังเกตเห็นตอนเจ้ากลับมาจากบึงหมอกเงิน มันหันไปทางนั้นเอง\n\nอัศวินดาบรูนกลุ่มสุดท้ายล้มลงที่บึงนั้น และไม่เคยมีใครพบศพพวกเขา ไปตามเสียงรูนดู — ศิลาแตก เงาในน้ำ และเสียงกระดิ่งใต้ราก มันจะพาเจ้าไปหาสิ่งที่ซ่อนอยู่"
dialog_progress = "ในบึงหมอกเงินมี 3 จุดที่รูนจะสั่นแรงขึ้น — ศิลารูนแตก เงาในน้ำ และกระดิ่งใต้รากทางปลายบึง"
dialog_complete = "รอยเขาสองข้าง... เงาที่ไม่มีตัว... และทางลงใต้ราก\n\nใต้บึงนั้นคือวิหารที่อัศวินใช้ตั้งรับครั้งสุดท้าย ตอนนี้มีปีศาจเขาดำยึดไว้ — บาฟโฟเมท มันถูกปล่อยไว้กินพลังจากรูนของคนตาย แล้วส่งขึ้นไปตามราก\n\nเจ้าเจอประตูแล้ว แต่ยังเข้าไปไม่ได้ ดาบของเจ้ายังไม่พร้อม"
required_flag = ""
set_flag_on_complete = "rb_clues"
required_level = 42
required_job = &"swordsman"
required_quests = Array[StringName]([&"rb2_unbound_rune", &"c3_3_mist_that_lingers", &"c3_4_song_of_child"])
objectives = Array[ExtResource("o")]([SubResource("O0"), SubResource("O1"), SubResource("O2")])
