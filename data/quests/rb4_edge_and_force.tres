[gd_resource type="Resource" script_class="QuestData" format=3]

[ext_resource type="Script" path="res://scripts/resources/quest_data.gd" id="q"]
[ext_resource type="Script" path="res://scripts/resources/objective_data.gd" id="o"]

[sub_resource type="Resource" id="O0"]
script = ExtResource("o")
kind = 5
target = &"rb_trial_rhythm"
count = 1
text = "ผ่านบททดสอบจังหวะของคม"

[sub_resource type="Resource" id="O1"]
script = ExtResource("o")
kind = 5
target = &"rb_trial_force"
count = 1
text = "ผ่านบททดสอบน้ำหนักของดาบ"

[resource]
script = ExtResource("q")
id = "rb4_edge_and_force"
title = "คมและแรง"
giver_name = "ผู้อาวุโสญอร์ดา"
description = "ที่ลานฝึกดาบ (ทางขวาของเมือง) ผ่าน 2 บททดสอบ: ① คอมโบครบ 3 ชุดโดยหลบแนวสีแดง ② ใช้คลื่นดาบเปิดแผล แล้วตามด้วยฟันแรงในช่วงวงสีทอง (เรียนและใส่ 2 สกิลนี้ไว้ก่อน)"
dialog_offer = "ก่อนจะลงไปใต้บึง เจ้าต้องเข้าใจดาบรูนก่อน มันไม่ได้แรงขึ้นเพราะเจ้าฟันหนักขึ้น มันแรงขึ้นเพราะเจ้าฟันถูกจังหวะ\n\nไปที่ลานฝึกดาบทางขวาของเมือง ข้าวางบททดสอบของอัศวินไว้สองบท — «จังหวะของคม» ฟันให้ครบคอมโบสามชุดโดยไม่โดนตีสวน และ «น้ำหนักของดาบ» เปิดแผลด้วยคลื่นดาบเปิดแผล แล้วซ้ำด้วยฟันแรงตอนหุ่นเผลอ"
dialog_progress = "ลานฝึกดาบอยู่ทางขวาของเมือง ผ่านให้ครบทั้งสองบท — «จังหวะของคม» และ «น้ำหนักของดาบ»"
dialog_complete = "ข้ารู้สึกได้จากตรงนี้ รูนของซินดริสั่นตามจังหวะดาบเจ้าแล้ว\n\nเมื่อเจ้าแกร่งพอ (เลเวล 50) ประตูใต้บึงจะยอมเปิดให้ ข้างในมีลูกสมุนของบาฟโฟเมทคอยต้อนจากด้านหลัง อย่าลืมหันไปดูข้างหลังบ้าง"
required_flag = ""
set_flag_on_complete = "rb_trials"
required_level = 48
required_job = &"swordsman"
required_quests = Array[StringName]([&"rb3_beneath_marsh", &"c3_6_withering"])
objectives = Array[ExtResource("o")]([SubResource("O0"), SubResource("O1")])
