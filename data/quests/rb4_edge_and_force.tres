[resource]
script = ExtResource("q")
id = "rb4_edge_and_force"
title = "R4 คมและแรง"
giver_name = "ผู้อาวุโสญอร์ดา"
description = "ไปยังศิลาทดสอบทางขวาของเมือง ใช้คอมโบปกติ และเปิดแผลด้วย Rending Wave ก่อนตามด้วย Bash ไม่จำเป็นต้องติดคริ"
dialog_offer = "ไปยังศิลาทดสอบทางขวาของเมือง ใช้คอมโบปกติ และเปิดแผลด้วย Rending Wave ก่อนตามด้วย Bash ไม่จำเป็นต้องติดคริ"
dialog_progress = "ตรวจเป้าหมายในสมุดเควส แล้วกลับมาคุยเมื่อครบ"
dialog_complete = "รูนทั้งสองประสานแล้ว เมื่อเจ้าเลเวล 50 ประตูใต้บึงจะเปิดให้ จงระวังลูกอสูรที่ไล่ต้อนจากด้านหลัง"
required_flag = ""
set_flag_on_complete = "rb_trials"
required_level = 48
required_job = &"swordsman"
required_quests = Array[StringName]([&"rb3_beneath_marsh", &"c3_6_withering"])
objectives = Array[ExtResource("o")]([SubResource("O0"), SubResource("O1")])
