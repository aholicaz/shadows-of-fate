[resource]
script = ExtResource("q")
id = "rb5_oath_eater"
title = "ผู้กินคำสัตย์"
giver_name = "ผู้อาวุโสญอร์ดา"
description = "เข้าวิหารเขาทมิฬใต้ราก (ซุ้มรากปลายบึงหมอกเงิน) ทำลายเสาพันธนาการ 3 ต้น ล้มบาฟโฟเมท แล้วปลดวงจรหลังบัลลังก์"
dialog_offer = "ถึงเวลาแล้ว ลงไปที่วิหารใต้ราก ทางเข้าอยู่ในซุ้มรากปลายบึงหมอกเงิน\n\nข้างในมีเสาพันธนาการสามต้น — แต่ละต้นล่ามรูนของอัศวินที่ตายไว้ ทำลายมันให้หมด แล้วล้มบาฟโฟเมท ผู้กินคำสัตย์\n\nหลังบัลลังก์ของมันคือวงจรที่ดูดพลังรูนส่งขึ้นไปตามราก หมุนมันกลับทิศเสีย ให้พลังไหลคืนสู่แผ่นดิน"
dialog_progress = "วิหารเขาทมิฬอยู่ใต้ซุ้มรากปลายบึงหมอกเงิน · เสาพันธนาการ 3 ต้น → บาฟโฟเมท → วงจรหลังบัลลังก์"
dialog_complete = "เมื่อครู่ ข้าได้ยินบ่อน้ำกลางเมืองหายใจ... ครั้งแรกในรอบสามร้อยปี\n\nรูนของพ่อข้ากับพวกพ้องได้อิสระแล้ว และรูนในมือเจ้า... มันร้องแล้ว ได้ยินไหม\n\nเหลืออีกขั้นเดียว ไปที่ศิลาคำสัตย์ แล้วจารึกคำสัตย์ของเจ้าเอง"
required_flag = ""
set_flag_on_complete = "rb_core"
required_level = 50
required_job = &"swordsman"
required_quests = Array[StringName]([&"rb4_edge_and_force"])
objectives = Array[ExtResource("o")]([SubResource("O0"), SubResource("O1")])
