[gd_resource type="Resource" script_class="QuestData" format=3]

[ext_resource type="Script" path="res://scripts/resources/quest_data.gd" id="q"]
[ext_resource type="Script" path="res://scripts/resources/objective_data.gd" id="o"]

[sub_resource type="Resource" id="O0"]
script = ExtResource("o")
kind = 4
target = &"rb_ceremony"
count = 1
text = "ตรวจดูศิลาคำสัตย์ เพื่ออ่านคำสัตย์"

[resource]
script = ExtResource("q")
id = "rb6_runeblade"
title = "คำสัตย์แห่งดาบรูน"
giver_name = "ผู้อาวุโสญอร์ดา"
description = "อ่านศิลาคำสัตย์ข้างลานเมือง แล้วกลับมาหาญอร์ดาเพื่อทำพิธีเปลี่ยนอาชีพเป็น Runeblade (อัศวินดาบรูน)"
dialog_offer = "ดาบรูนไม่มีคำสัตย์สำเร็จรูปให้ท่องตาม แต่ละคนต้องเลือกเองว่าจะถือดาบไว้เพื่ออะไร\n\nบรอกก์ให้รูปร่างกับเหล็ก ซินดริให้วงจรกับรูน ส่วนเจ้า... ต้องเป็นคนบอกว่าพลังนี้จะไปทางไหน ไปที่ศิลาคำสัตย์ อ่านมัน แล้วกลับมาบอกข้า"
dialog_progress = "ศิลาคำสัตย์อยู่ข้างลานเมือง อ่านแล้วกลับมาหาข้า"
dialog_complete = "รูนรับคำสัตย์ของเจ้าแล้ว... เจ้าคืออัศวินดาบรูนคนแรกในรอบสามร้อยปี — Runeblade\n\nถ้าได้กลับไปใต้ภูเขา บอกบรอกก์ด้วยว่ารูนของซินดริร้องแล้ว เขารอฟังประโยคนี้มานานกว่าที่เจ้าคิด\n\n(เลือกสายคมหรือสายหนักได้ในหน้าสกิล · ขอคืนแต้มสกิล Runeblade ได้ที่ศิลาคำสัตย์)"
required_flag = ""
set_flag_on_complete = "runeblade_awakened"
required_level = 50
required_job = &"swordsman"
required_quests = Array[StringName]([&"rb5_oath_eater"])
objectives = Array[ExtResource("o")]([SubResource("O0")])
reward_job = &"runeblade"

choice_prompt = "ญอร์ดายื่นดาบคืนให้เจ้า — «พูดคำสัตย์ของเจ้าออกมา ดาบจะจำมันไว้» (เปลี่ยนสายสกิลภายหลังได้)"
choice_options = Array[String](["«ข้าจะไม่หยุดฟัน จนกว่าทุกคนจะปลอดภัย» (แนะนำสายคม · ตีไว-คริ)", "«สิ่งใดขวางทาง ข้าจะทลายมันเอง» (แนะนำสายหนัก)"])
choice_flags = Array[StringName]([&"rb_prefers_edge", &"rb_prefers_sunder"])
