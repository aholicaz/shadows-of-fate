[resource]
script = ExtResource("q")
id = "rb7_ninth_inscription"
title = "R7 อักขระที่เก้า"
giver_name = "ผู้อาวุโสญอร์ดา"
description = "รูนของเจ้ายังมีวงจรที่ไม่สว่าง อ่านบรรทัดสุดท้ายที่ศิลา บางทีการเดินทางนี้เพิ่งเริ่มต้น"
dialog_offer = "รูนของเจ้ายังมีวงจรที่ไม่สว่าง อ่านบรรทัดสุดท้ายที่ศิลา บางทีการเดินทางนี้เพิ่งเริ่มต้น"
dialog_progress = "ตรวจเป้าหมายในสมุดเควส แล้วกลับมาคุยเมื่อครบ"
dialog_complete = "เมื่อถึงเลเวล 90 จงกลับมาตรวจอักขระอีกครั้ง เส้นทางอาชีพขั้นถัดไปยังรอเรื่องราวจากดินแดนทางเหนือ"
required_flag = ""
set_flag_on_complete = "rb_next_job_hint"
required_level = 50
required_job = &"runeblade"
required_quests = Array[StringName]([&"rb6_runeblade"])
objectives = Array[ExtResource("o")]([SubResource("O0")])
