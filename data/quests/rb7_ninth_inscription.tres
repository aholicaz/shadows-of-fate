[gd_resource type="Resource" script_class="QuestData" format=3]

[ext_resource type="Script" path="res://scripts/resources/quest_data.gd" id="q"]
[ext_resource type="Script" path="res://scripts/resources/objective_data.gd" id="o"]

[sub_resource type="Resource" id="O0"]
script = ExtResource("o")
kind = 4
target = &"rb_ninth_inscription"
count = 1
text = "ตรวจดูศิลาคำสัตย์ เพื่ออ่านอักขระจาง"

[resource]
script = ExtResource("q")
id = "rb7_ninth_inscription"
title = "อักขระที่เก้า"
giver_name = "ผู้อาวุโสญอร์ดา"
description = "อ่านอักขระจางบรรทัดสุดท้ายที่ศิลาคำสัตย์"
dialog_offer = "ใต้บัลลังก์ของบาฟโฟเมท เจ้าเห็นวงรูนเก้าดวงใช่ไหม... วานีร์อย่างเรารู้จักแค่สามดวงแรก ที่เหลือกระจายอยู่ในโลกอื่น\n\nไปที่ศิลาคำสัตย์อีกครั้ง บรรทัดล่างสุดมีอักขระจาง ๆ ที่ข้าอ่านไม่ออก ลองให้ดาบของเจ้าอ่านดู"
dialog_progress = "ที่ศิลาคำสัตย์ข้างลานเมือง เลือก «อ่านอักขระที่เก้า»"
dialog_complete = "รูนดวงที่สี่กับห้าเป็นของยักษ์ ดวงที่หกกับเจ็ดซ่อนอยู่ในแสงของเอลฟ์ ดวงที่แปดอยู่กับคนตาย...\n\nส่วนดวงที่เก้า ไม่มีใครรู้ว่าอยู่ที่ไหน บางทีอาจยังไม่เคยมีใครสลักมันเลยก็ได้\n\nเดินทางต่อไปทางเหนือเถอะ ช่างสลักรูนที่โยตุนเฮมจะสอนดวงถัดไปให้ เมื่อถึงวันที่เจ้าพร้อม (เลเวล 90) รูนดวงสุดท้ายจะเรียกหาเจ้าเอง"
required_flag = ""
set_flag_on_complete = "rb_next_job_hint"
required_level = 50
required_job = &"runeblade"
required_quests = Array[StringName]([&"rb6_runeblade"])
objectives = Array[ExtResource("o")]([SubResource("O0")])
