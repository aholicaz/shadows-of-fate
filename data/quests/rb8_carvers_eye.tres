[resource]
script = ExtResource("1_quest")
id = &"rb8_carvers_eye"
title = "RB8 ตาของช่างสลัก"
description = "เกอร์ดจะสลักรูนดวงที่สี่ «กำเนิด» ลงในดาบรูนของเจ้า"
giver_name = "ช่างสลักรูนเกอร์ด"
dialog_offer = "เจ้าถือรูนที่ธอร์ขโมยไป... ไม่เป็นไร รูนไม่สนใจว่าใครถือ มันสนใจว่าถือยังไง\n\nเอาแกนหินมาอีก 3 ก้อน ล่าทหารหินให้ข้าฟังเสียงดาบเจ้า แล้วอ่านจารึกบนกำแพง — รูนดวงที่สี่อยู่ในนั้น"
dialog_progress = "ทหารหิน 10 · แกนหินยักษ์ 3 · อ่านจารึกฝั่งยักษ์ที่กำแพง"
dialog_complete = "«กำเนิด» — รูนที่ยักษ์สลักดวงแรกในโลก ก่อนมีเทพ\n\nดาบเจ้าสว่างขึ้นดวงหนึ่งแล้ว ตาข้ามองไม่เห็น แต่ข้าได้ยินมัน"
objectives = Array[ExtResource("2_obj")]([SubResource("Obj_0"), SubResource("Obj_1"), SubResource("Obj_2")])
kill_monster_id = &""
required_level = 66
required_job = &"runeblade"
required_quests = Array[StringName]([&"rb7_ninth_inscription", &"c4_6_fourth_rune"])
set_flag_on_complete = &"rb_rune_4"
reward_zeny = 10000
reward_exp = 60000
