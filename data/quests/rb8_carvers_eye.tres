[resource]
script = ExtResource("1_quest")
id = &"rb8_carvers_eye"
title = "ตาของช่างสลัก"
description = "ล่าทหารหินยักษ์ 10 ตัว เก็บแกนหินยักษ์ 3 ก้อน และอ่านจารึกภาษายักษ์บนกำแพง ให้เกอร์ดสลักรูนดวงที่สี่ «กำเนิด» ลงในดาบ"
giver_name = "ช่างสลักรูนเกอร์ด"
dialog_offer = "ดาบเจ้ามีรูนสามดวงที่วานีร์สอน... ข้าได้ยินมันตั้งแต่เจ้าเดินเข้าร้าน รูนพวกนี้ธอร์เคยขโมยไปจากพวกเรา แต่ช่างเถอะ รูนไม่สนว่าใครถือ มันสนแค่ว่าถือยังไง\n\nหาแกนหินยักษ์มาอีก 3 ก้อน แล้วไปฟันทหารหินที่กำแพงให้ข้าฟังเสียงดาบเจ้า ระหว่างนั้นไปอ่านจารึกบนกำแพงด้วย รูนดวงที่สี่ซ่อนอยู่ในนั้น"
dialog_progress = "ทหารหินยักษ์ 10 ตัว · แกนหินยักษ์ 3 ก้อน · อ่านจารึกภาษายักษ์บนกำแพงที่แตก"
dialog_complete = "«กำเนิด» — รูนดวงแรกที่ยักษ์สลักขึ้นในโลกนี้ ก่อนจะมีเทพองค์ไหนเสียอีก\n\nดาบเจ้ามีสี่ดวงแล้ว ตาข้ามองไม่เห็น แต่ข้าได้ยินมันร้อง"
objectives = Array[ExtResource("2_obj")]([SubResource("Obj_0"), SubResource("Obj_1"), SubResource("Obj_2")])
kill_monster_id = &""
required_level = 66
required_job = &"runeblade"
required_quests = Array[StringName]([&"rb7_ninth_inscription", &"c4_6_fourth_rune"])
set_flag_on_complete = &"rb_rune_4"
reward_zeny = 1337
reward_exp = 8022

