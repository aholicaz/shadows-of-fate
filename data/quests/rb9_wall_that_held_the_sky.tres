text = "ใช้ท่าสายหนักโดนผู้ถือโล่"

[resource]
script = ExtResource("1_quest")
id = &"rb9_wall_that_held_the_sky"
title = "กำแพงที่ค้ำฟ้า"
description = "ล้มผู้ถือโล่แห่งกำแพง โดยใช้สกิลสายหนัก (ดาบฟาดทั่ง · ดาบปักอักขระ · ฝนดาบผ่าโลก) โดนเขาอย่างน้อย 1 ครั้ง"
giver_name = "ช่างสลักรูนเกอร์ด"
dialog_offer = "ผู้ถือโล่ที่เฝ้ากำแพงน่ะ... เขาไม่ได้แค่เฝ้ากำแพง เขาคือกำแพงเสียเอง เกราะของเขาหนากว่าทุกอย่างที่ดาบเจ้าเคยเจอ\n\nรูนดวงที่ห้าคือ «กำแพง» จะได้มันมา เจ้าต้องทลายกำแพงให้ได้ก่อน ใช้ท่าสายหนัก — ดาบฟาดทั่ง ดาบปักอักขระ หรือฝนดาบผ่าโลก — ทลายเขาให้ข้าฟัง"
dialog_progress = "ล้มผู้ถือโล่แห่งกำแพง — ต้องมีท่าสายหนักโดนเขาอย่างน้อย 1 ครั้ง"
dialog_complete = "«กำแพง» — รูนดวงที่ห้า ยักษ์เคยสลักมันไว้บนกำแพงจริง ๆ ก่อนกำแพงจะแตก\n\nตอนนี้ดาบเจ้ารู้จักหารอยต่อในเกราะที่แข็งที่สุดแล้ว — ท่า «อ่านรอยพันธะ» เกิดจากรูนดวงนี้\n\nดวงต่อไปเป็นรูนแห่งแสง ข้าสลักให้ไม่ได้ ไปหาคนที่ตาบอดเพราะแสงที่อัลฟ์เฮม"
objectives = Array[ExtResource("2_obj")]([SubResource("Obj_0"), SubResource("Obj_1")])
kill_monster_id = &""
required_level = 70
required_job = &"runeblade"
required_quests = Array[StringName]([&"rb8_carvers_eye", &"c4_8_shieldbearer"])
set_flag_on_complete = &"rb_rune_5"
reward_zeny = 1495
reward_exp = 8971

reward_job_exp = 6279
