title = "กระสอบที่ถูกกัด"
description = "ล่าหมาป่า 20 ตัวนอกเมือง ให้โทนี่ขนสินค้าได้อย่างปลอดภัย"
giver_name = "พ่อค้าโทนี่"
dialog_offer = "แย่แล้ว ๆ! ฝูงหมาป่านอกเมืองลากกระสอบสินค้าข้าไปกัดขาดหมดเลย\n\nช่วยไล่ล่าพวกมันสัก 20 ตัวได้ไหม ค่าจ้างงามแน่นอน"
dialog_progress = "ยังไม่ครบ 20 ตัวเลยนะ กระสอบรอบหน้าข้าไม่อยากเสียอีกแล้ว"
dialog_complete = "สุดยอด! ทีนี้ข้าก็ขนของได้สบายใจแล้ว นี่ค่าจ้างตามที่ตกลงกันไว้"
kill_monster_id = &"wolf"
