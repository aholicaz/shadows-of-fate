[resource]
script = ExtResource("s")
id = &"jump_slash"
display_name = "กระโดดผ่ารูน"
description = "กระโดดสูงเหนือศีรษะแล้วพุ่งตามทิศที่หัน 600 px แล้วฟันปล่อยคลื่นแนวยาว 1260 px สร้าง 408–1272% ATK ต่อเป้าหมายหนึ่งครั้ง หยุดเมื่อชนกำแพง ใช้ได้เมื่ออยู่บนพื้น และยังรับความเสียหายระหว่างท่า"
