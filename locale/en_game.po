msgid "ดาบเขากวาง"
msgstr "Stag Horn Saber"

msgid "ดาบเงาค้อนล่ม"
msgstr "Hammerfall Shadow Blade"

msgid "ดาบเตาหลอม"
msgstr "Forge Saber"

msgid "ดาบเพลิง"
msgstr "Flame Sword"

msgid "ดาบเพลิงกุลล์ไวก์"
msgstr "Ember of Gullveig"

msgid "ดาบเรียวปลายแหลม แทงแม่นและเข้าจุดตาย"
