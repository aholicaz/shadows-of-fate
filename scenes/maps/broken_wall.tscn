[node name="Lore" type="Node2D" parent="."]


[node name="WallInscription" parent="Lore" instance=ExtResource("lore")]
position = Vector2(1500, 790)
lore_id = &"wall_inscription"
title = "จารึกฝั่งยักษ์"
text = "รูนยักษ์สลักลึกลงในกำแพง ตัวอักษรใหญ่เท่าประตู\n\n«กำแพงนี้สร้างเพื่อกันฟ้า ไม่ใช่กันคน\nคนเดินผ่านประตูได้ ฟ้าต้องหยุดที่นี่»\n\nมนุษย์เรียกมันว่า «กำแพงกันยักษ์» — ยักษ์เรียกมันว่า «กำแพงกันเทพ»"
label_text = "จารึกบนกำแพง"


[node name="WallBreach" parent="Lore" instance=ExtResource("lore")]
position = Vector2(3250, 790)
lore_id = &"wall_breach"
title = "รอยแตกของกำแพง"
text = "รอยแตกกว้างพอให้กองทัพเดินผ่านสิบแถว\n\nขอบรอยแตกฝั่ง «ใต้» ถูกกะเทาะออก — หินกระเด็นเข้ามาข้าง «ใน» เมืองยักษ์\nถ้ายักษ์ทุบกำแพงออกไปบุกมนุษย์ หินต้องกระเด็นออกไปข้างนอก\n\nแต่หินอยู่ข้างใน\n\nกำแพงไม่ได้ถูกทุบจากข้างใน... มันถูกทุบจากฝั่งมนุษย์"
label_text = "รอยแตก"

