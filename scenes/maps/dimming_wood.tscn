[node name="NPCs" type="Node2D" parent="."]


[node name="Sol_exile" parent="NPCs" instance=ExtResource("npc")]
position = Vector2(1400, 820)
npc_name = "โซล (ผู้ถูกทิ้ง)"
type = 0
dialog = "ข้าเริ่ม «รู้สึก» วันหนึ่ง แค่นั้น เศร้านิดเดียว... แล้วพวกเขาก็พาข้ามาที่นี่\n\nที่นี่คือที่ที่เอลฟ์ «เสีย» ถูกทิ้ง เมืองจำเราไม่ได้ เพราะแสงกรองเราออกไปแล้ว"
modulate = Color(1, 1, 1, 0.70)
greeting = "...เจ้า เจ้าคือคนที่ถามข้าเรื่องกลางคืน"
quest_ids = Array[StringName]([&"c5_9_where_the_light_goes"])
show_if_flag = &"knows_exile"


[node name="Lore" type="Node2D" parent="."]


[node name="ExileStone" parent="Lore" instance=ExtResource("lore")]
position = Vector2(3000, 790)
lore_id = &"exile_stone"
title = "ศิลาผู้ถูกทิ้ง"
text = "ศิลาเก่ามีชื่อสลักเป็นร้อย ๆ ชื่อ ทุกชื่อคือเอลฟ์ที่ «หลุดจากแสง»\n\nข้างล่างสุด ตัวอักษรเก่าที่สุด:\n«สัญญาแห่งแสง — เราให้แสง เขาให้ความสงบ\nผู้ที่รู้สึกได้ ให้มาอยู่ที่นี่ จนกว่าจะลืม»\n\nและใต้นั้น มีชื่อหนึ่งถูกลบ — ชื่อของคนที่คัดค้านสัญญา"
label_text = "ศิลา"
set_flag = &"saw_exile_stone"

