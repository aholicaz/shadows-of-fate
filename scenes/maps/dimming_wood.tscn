[node name="NPCs" type="Node2D" parent="." unique_id=1610914066]

[node name="Sol_exile" parent="NPCs" unique_id=857380335 instance=ExtResource("npc")]
modulate = Color(1, 1, 1, 0.7)
position = Vector2(1400, 820)
npc_name = "โซล (ผู้ถูกทิ้ง)"
type = 0
dialog = "ข้าเริ่ม «รู้สึก» วันหนึ่ง แค่นั้น เศร้านิดเดียว... แล้วพวกเขาก็พาข้ามาที่นี่

ที่นี่คือที่ที่เอลฟ์ «เสีย» ถูกทิ้ง เมืองจำเราไม่ได้ เพราะแสงกรองเราออกไปแล้ว"
show_if_flag = &"knows_exile"
greeting = "...เจ้า เจ้าคือคนที่ถามข้าเรื่องกลางคืน"
quest_ids = Array[StringName]([&"c5_9_where_the_light_goes"])

[node name="FootShadow" type="Sprite2D" parent="NPCs/Sol_exile" unique_id=1923484077]
script = ExtResource("npc_shadow")
fit_actor_size = true

[node name="Lore" type="Node2D" parent="." unique_id=1020242709]

[node name="ExileStone" parent="Lore" unique_id=1005961960 instance=ExtResource("lore")]
position = Vector2(3000, 790)
lore_id = &"exile_stone"
title = "ศิลาผู้ถูกทิ้ง"
text = "ศิลาเก่ามีชื่อสลักเป็นร้อย ๆ ชื่อ ทุกชื่อคือเอลฟ์ที่ «หลุดจากแสง»

ข้างล่างสุด ตัวอักษรเก่าที่สุด:
«สัญญาแห่งแสง — เราให้แสง เขาให้ความสงบ
ผู้ที่รู้สึกได้ ให้มาอยู่ที่นี่ จนกว่าจะลืม»

และใต้นั้น มีชื่อหนึ่งถูกลบ — ชื่อของคนที่คัดค้านสัญญา"
set_flag = &"saw_exile_stone"
label_text = "ศิลา"
