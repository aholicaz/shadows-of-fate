[node name="InvasionMural" parent="Lore" unique_id=57416395 instance=ExtResource("lore")]
position = Vector2(2700, 790)
lore_id = &"invasion_mural"
title = "ภาพวาดบนผนังน้ำแข็ง"
text = "ภาพวาดยาวเต็มผนัง สีซีดแต่เส้นยังชัด

ด้านซ้าย: เมืองยักษ์ ผู้คนถือถ้วย เด็กวิ่งเล่น
ด้านขวา: กำแพงสูง — รอยแตกอยู่ฝั่ง «ใต้» ของกำแพง

และจากรอยแตกนั้น... กองทัพเดินเข้ามา นำหน้าด้วยชายถือค้อน สายฟ้าอยู่รอบตัวเขา

กองทัพไม่ได้ป้องกันอะไร กองทัพกำลังเดินเข้าเมือง

มุมซ้ายล่างของภาพถูกขูดออก เหมือนมีใครไม่อยากให้เห็นว่าใครยืนอยู่ตรงนั้น"
set_flag = &"saw_invasion_mural"
label_text = "★ ภาพวาดโบราณ ★"


[node name="ChildDrawing" parent="Lore" unique_id=528243937 instance=ExtResource("lore")]
position = Vector2(1300, 790)
lore_id = &"child_drawing"
title = "รอยขีดเล็ก ๆ ใต้ภาพ"
text = "ใต้ภาพวาดใหญ่ มีรอยขีดเล็ก ๆ ระดับหัวเข่าเรา... ระดับมือเด็กยักษ์

เป็นรูปคนตัวเล็กจับมือคนตัวใหญ่ เขียนกำกับด้วยรูนเด็ก: «เพื่อน»

วาดก่อนหรือหลังกำแพงแตก ไม่มีใครรู้"
label_text = "รอยขีด"

