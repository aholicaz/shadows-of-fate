[node name="NPCs" type="Node2D" parent="."]


[node name="Modgud" parent="NPCs" instance=ExtResource("npc")]
position = Vector2(2700, 820)
npc_name = "ผู้เฝ้าสะพานโมดกุด"
type = 0
dialog = "ข้าเฝ้าสะพานมาตั้งแต่โลกมีคนตาย ทุกคนที่ข้ามไปทิ้งชื่อไว้กับข้า\n\nเจ้าเป็นคนเป็น... แต่กฎเหมือนกัน อยากไปโถงแห่งนาม ต้องไม่มีชื่อ"
modulate = Color(1, 1, 1, 0.70)
greeting = "สะพานทองคำ... ผู้ข้ามต้องจ่าย และค่าข้ามคือชื่อ"
voice_id = "modgud"
quest_ids = Array[StringName]([&"c6_3_leave_your_name"])
quest_talk_names = Array[StringName]([&"ผู้เฝ้าสะพานโมดกุด"])
dialog_by_flag = {
"name_left": "ชื่อของเจ้าอยู่กับข้าแล้ว... ข้าจะเก็บไว้ดี ๆ\n\nไปเถอะ คนไร้นาม โถงอยู่ข้างหน้า",
"job_ninth_edge": "เจ้า... เจ้าสลักชื่อใหม่ได้ ในโถงที่ชื่อทุกชื่อถูกลบ\n\nข้าเก็บชื่อเก่าของเจ้าไว้ให้ ถ้าอยากได้คืน... แต่เจ้าคงไม่ต้องแล้ว"
}


[node name="Lore" type="Node2D" parent="."]


[node name="BridgeToll" parent="Lore" instance=ExtResource("lore")]
position = Vector2(1900, 790)
lore_id = &"bridge_toll"
title = "ค่าข้ามสะพาน"
text = "แผ่นทองคำที่หัวสะพาน สลักด้วยอักษรผู้ตาย\n\n«ผู้ข้ามต้องทิ้งชื่อ — เพราะข้างหน้าคือโถงที่ชื่อทุกชื่อถูกลบ\nคนมีชื่อเข้าไปแล้วจะถูกลบตาม\nคนไม่มีชื่อ... ไม่มีอะไรให้ลบ»\n\nข้างล่างมีคนเขียนเพิ่ม ลายมือสั่น:\n«ผู้กองสั่งห้ามเข้าป่า เพราะป่าถูกดูด — ข้าไม่ได้บ้า»"
label_text = "แผ่นทอง"

