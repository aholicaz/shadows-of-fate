[node name="OdinName" parent="Lore" instance=ExtResource("lore")]
position = Vector2(2450, 790)
lore_id = &"odin_name"
title = "ชื่อบนผนัง"
text = "ผนังทั้งโถงมีชื่อไหลอยู่ — ชื่อทุกชื่อที่ถูกสกัดออกจากศิลา หลุมศพ พงศาวดาร ทั่วเก้าโลก\n\nซินดริ... หรุงนีร์... โซล... ชื่อที่ถูกลบจากข้างบน มาอยู่ที่นี่ทั้งหมด\n\nและตรงกลางผนัง ตัวอักษรใหญ่กว่าชื่ออื่น ยังอ่านออกชัด:\n\n« โ อ ดิ น »\n\nโอดินไม่ได้หายไป โอดินตาย — และชื่อของเขาถูกลบจากข้างบน เหมือนทุกคนที่นี่"
label_text = "★ ชื่อที่ยังอ่านออก ★"
set_flag = &"saw_odin_name"


[node name="ErasedName" parent="Lore" instance=ExtResource("lore")]
position = Vector2(2650, 790)
lore_id = &"erased_name"
title = "ชื่อข้างโอดิน"
text = "ข้างชื่อโอดิน มีอีกชื่อหนึ่ง... ถูกลบจนอ่านไม่ออก แม้ในโถงที่เก็บชื่อที่ถูกลบ\n\nลบสองชั้น — ลบจากข้างบน แล้วลบจากที่นี่อีกครั้ง\nใครก็ตามที่ทำแบบนี้ ไม่อยากให้แม้แต่คนตายจำชื่อนี้ได้\n\nรอยเปื้อนมีรูปร่างเหมือนตัวอักษรสี่ตัว... ตัวแรกคล้ายรูน «ล»"
label_text = "รอยเปื้อน"
required_flag = &"saw_odin_name"
locked_text = "ยังไม่ได้ดูชื่อที่ยังอ่านออกตรงกลางผนัง"
set_flag = &"saw_erased_name"

