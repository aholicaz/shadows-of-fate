position = Vector2(2600, 790)
lore_id = &"lightning_heart"
title = "หัวใจสายฟ้า"
text = "ร่างหินของจอมพลยักษ์ล้มลงแล้ว แต่ในอกที่แตกออก... หัวใจสีฟ้ายังเต้นอยู่\n\nตุบ... ตุบ...\n\nบนหัวใจมีตราสลัก — ตราค้อน\nหัวใจนี้ไม่ใช่ของหรุงนีร์ มันถูก «ฝัง» เข้าไปหลังจากเขาตาย\nเพื่อให้ศพลุกขึ้นมาทำลายเมืองของตัวเอง\n\nรูนวงจร «ดูด» ดวงที่ 3 — ค้อน · บ่อน้ำ · หัวใจ"
label_text = "★ หัวใจที่ยังเต้น ★"
required_flag = &"killed_stone_hrungnir"
locked_text = "หรุงนีร์ศิลายังยืนอยู่ หัวใจสีฟ้าเรืองอยู่กลางอกมัน"
set_flag = &"saw_lightning_heart"

