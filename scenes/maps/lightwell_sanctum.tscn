[node name="Lore" type="Node2D" parent="."]


[node name="SiphonRoot" parent="Lore" instance=ExtResource("lore")]
position = Vector2(2400, 790)
lore_id = &"siphon_root"
title = "ท่อรากดูดแสง"
text = "เมื่ออัลฟ์เรืองรองล้มลง แสงหยุดไหล... และเจ้าเห็นมันชัดเป็นครั้งแรก\n\nท่อรากใหญ่โผล่จากบ่อแสง ต่อขึ้นไปบนฟ้า — ขึ้นอิกดราซิล\nแสงของเมืองทั้งเมืองถูกดูดขึ้นท่อนี้มาพันปี พร้อมกับความเศร้า ความแก่ ความสงสัย\n\nรูนวงจร «ดูด» ดวงที่ 4 — ค้อน · บ่อน้ำ · หัวใจ · บ่อแสง\nปลายท่อชี้ขึ้นเหนือ... และมีอีกท่อ ลงใต้ดิน ไปที่ที่ไม่มีแสงเลย"
label_text = "★ ท่อราก ★"
required_flag = &"killed_radiant_alfr"
locked_text = "อัลฟ์เรืองรองยังลอยอยู่กลางบ่อแสง แสงทั้งเมืองไหลผ่านตัวเขาขึ้นไป"
set_flag = &"saw_siphon_root"

