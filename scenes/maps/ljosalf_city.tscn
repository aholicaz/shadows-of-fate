[node name="Sol" parent="NPCs" instance=ExtResource("npc") groups=["light_only"]]
position = Vector2(330, 820)
npc_name = "ทหารยามโซล"
type = 0
dialog = "ข้าเฝ้าประตูมา... นานเท่าไหร่นะ ไม่สำคัญหรอก ทุกวันเหมือนกัน ☺\n\nกลางคืน? กลางคืนคืออะไร"
greeting = "ยินดีต้อนรับสู่ลโยซาลฟ์ ☺ ที่นี่ไม่มีใครขาดอะไร"
voice_id = "sol"
quest_ids = Array[StringName]([&"c5_5_thing_in_the_water"])


[node name="Sol_hollow" parent="NPCs" instance=ExtResource("npc") groups=["dim_only"]]
position = Vector2(330, 820)
npc_name = "เอลฟ์กลวง (โซล)"
type = 0
dialog = "ข้าเคยยืนตรงนี้... เฝ้าอะไรสักอย่าง\n\nแสงไปไหน ทำไมทุกคนยังยิ้ม"
visible = false
modulate = Color(1, 1, 1, 0.60)
greeting = "...หนาว"


[node name="Eir" parent="NPCs" instance=ExtResource("npc")]
position = Vector2(700, 820)
npc_name = "ผู้เห็นแสงเอย์ร"
type = 0
dialog = "ข้าตาบอดเพราะมองแสงตรง ๆ นานเกินไป — ตอนนั้นข้าเห็นว่าแสงไหลไปทางไหน\n\nขึ้น มนุษย์ แสงของเมืองนี้ไหลขึ้นราก ไม่ใช่ลงมาจากฟ้า"
greeting = "เจ้าไม่ยิ้ม... ดี ที่นี่มีแค่ข้าคนเดียวที่ไม่ยิ้ม"
voice_id = "eir"
quest_ids = Array[StringName]([&"c5_1_city_without_night", &"c5_4_child_who_never_saw_stars", &"c5_6_those_who_are_missing", &"c5_10_the_conduit", &"rb10_borrowed_light", &"rb11_shadow_of_the_blade"])
dialog_by_flag = {
"has_shade_crystal": "เจ้าได้ผลึกเงาแล้ว... ไปที่ผลึกใหญ่กลางเมือง สลับร่างได้ตามใจ\n\nเห็นแล้วใช่ไหม ว่าใครหายไป",
"chapter5_done": "เมืองมืด... หรือสว่าง เจ้าเลือกแล้ว ข้าไม่ตัดสิน\n\nทางลงนิฟล์เฮมอยู่ที่วิหารบ่อแสง ตรงท่อราก ที่นั่นไม่มีแสงเลย มนุษย์ — และคนตายพูดได้"
}


[node name="Dagr" parent="NPCs" instance=ExtResource("npc") groups=["light_only"]]
position = Vector2(1200, 820)
npc_name = "เจ้าเมืองดาเกอร์"
type = 0
dialog = "ลโยซาลฟ์สงบมาพันปี ไม่มีสงคราม ไม่มีความเศร้า ไม่มีใครแก่\n\nเจ้าอยากได้แบบนี้บ้างไหม ☺"
greeting = "ยินดีต้อนรับ ☺ ไม่มีอะไรผิดปกติที่นี่ ไม่เคยมี"
voice_id = "dagr"
quest_ids = Array[StringName]([&"c5_2_gift_of_light", &"c5_8_forsaken"])
hide_if_flag = &"dagr_left"
dialog_by_flag = {
"knows_exile": "เจ้าไปป่าจางมาแล้ว... ☺ ที่นั่นไม่มีอะไรหรอก ไม่มีใครอยู่ที่นั่น ☺ ☺"
}


[node name="Lofn" parent="NPCs" instance=ExtResource("npc")]
position = Vector2(1650, 820)
npc_name = "แม่ค้าลอฟน์"
type = 1
dialog = "ข้าขายของมา... ตั้งแต่จำความได้ ทุกคนซื้อของเดิม ทุกวัน ☺\n\nกลางคืน? เจ้าเป็นคนที่สองที่ถามข้าวันนี้... ไม่สิ คนแรก ไม่มีใครถาม"
shop_items = Array[StringName]([&"red_potion", &"orange_potion", &"white_potion", &"blue_potion", &"meat", &"phracon", &"emveretarcon", &"prism_blade", &"stag_horn_saber", &"light_crystal_sword", &"crystal_shield", &"ljosalf_circlet", &"crystal_cloak", &"moth_wing_cape", &"silent_step", &"frost_edge", &"troll_cleaver", &"wall_shield", &"jotun_helm", &"troll_boots"])
greeting = "ราคาทุกอย่างลงท้ายด้วยศูนย์ ไม่มีการต่อรอง ☺ ที่นี่ไม่มีใครขาดอะไร"
voice_id = "lofn"
quest_ids = Array[StringName]([&"c5_3_garden_that_never_wilts"])
dialog_by_flag = {
"knows_exile": "โซล? โซลไหน ☺ ที่นี่ไม่มีใครชื่อโซล"
}


[node name="Volundr" parent="NPCs" instance=ExtResource("npc")]
position = Vector2(2050, 820)
npc_name = "ช่างแสงโวลุนด์"
type = 2
dialog = "ของที่สมบูรณ์แบบไม่มีรอยตีค้อน\n\nราคาของความสมบูรณ์แบบคือ ถ้าไม่สมบูรณ์ ก็ไม่มีอยู่เลย ☺"
has_socket = true
has_refine = true
greeting = "ข้าตีบวกด้วยแสง สำเร็จบ่อยกว่าค้อน ☺ แต่ถ้าพัง — หายไปทั้งชิ้น ไม่เหลือซาก"
voice_id = "volundr"
quest_ids = Array[StringName]([&"c5_7_light_that_breaks"])


[node name="Nott" parent="NPCs" instance=ExtResource("npc")]
position = Vector2(2450, 820)
npc_name = "หมอน็อตต์"
type = 3
dialog = "ที่นี่ไม่มีใครป่วย ข้าเลยรักษาแต่คนนอก\n\nเจ้าดูเหนื่อย... เหนื่อยคืออะไรนะ ☺"
heal_price = 2500
greeting = "ข้าชื่อน็อตต์ ☺ ไม่รู้แปลว่าอะไร ไม่มีใครรู้"
voice_id = "nott"
dialog_by_flag = {
"knows_exile": "โซล... ☺ ข้าไม่รู้จัก ทำไมข้าถึงรู้สึกว่าควรรู้จัก",
"s8_done": "น็อตต์... แปลว่ากลางคืน\n\nข้า... ข้าเคยมีมัน ข้าจำได้แล้ว ข้าเคยหลับ"
}


[node name="LightWell_small" parent="NPCs" instance=ExtResource("npc") groups=["light_only"]]
position = Vector2(2850, 820)
npc_name = "บ่อแสงเล็ก"
type = 4
dialog = "บ่อแสงเล็กกลางเมือง · เซฟด้วยแสง · เลือกปลายทางแล้วก้าวเข้าไปได้เลย"
warp_targets = Array[StringName]([&"prontera_town", &"nidavellir_town", &"vanir_town", &"utgard_town", &"eljudnir"])


[node name="Ylva" parent="NPCs" instance=ExtResource("npc")]
position = Vector2(3350, 820)
npc_name = "เด็กเอลฟ์อิลวา"
type = 0
dialog = "อิลวาไม่เคยออกจากเมือง ทุกคนบอกว่าข้างนอกไม่มีอะไร\n\nพี่รู้จัก «ดาว» ไหม ในหนังสือเก่ามีคำนี้ แต่ไม่มีใครรู้ว่าคืออะไร"
greeting = "พี่มาจากข้างนอกเหรอ ☺ ข้างนอกมีอะไร"
voice_id = "ylva"
dialog_by_flag = {
"has_frida_song": "พี่มีกระดาษเพลง... ร้องให้อิลวาฟังหน่อยได้ไหม\n\n(อิลวาฟังเพลงของฟรีดาจนจบ ท่อนสุดท้ายพูดถึงดาว... ตาเธอเปียก)\n\nนี่คืออะไร ทำไมน้ำไหลจากตา",
"ylva_cried": "...น้ำที่ไหลจากตา นี่คืออะไร\n\nเพลงของฟรีดา... เด็กคนนั้นเห็นดาวจริง ๆ เหรอ อิลวาอยากเห็น",
"let_dark": "พี่! อิลวาเห็นแล้ว! จุดสว่างเล็ก ๆ บนฟ้ามืด... นั่นคือดาวใช่ไหม\n\nอิลวาร้องไห้อีกแล้ว แต่ครั้งนี้ไม่เหมือนครั้งแรก",
"restore_light": "แสงกลับมาแล้ว... ☺ อิลวาเกือบได้เห็นดาว\n\nไม่เป็นไร อิลวาจำได้ว่ามันมีอยู่ แค่นั้นก็พอ"
}

