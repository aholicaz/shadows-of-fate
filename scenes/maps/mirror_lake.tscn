[node name="LakeReflection" parent="Lore" instance=ExtResource("lore")]
position = Vector2(2700, 790)
lore_id = &"lake_reflection"
title = "เงาในน้ำ"
text = "ผิวน้ำนิ่งเหมือนกระจก... สะท้อนเมืองลโยซาลฟ์ที่อยู่ไกลออกไป\n\nแต่เมืองในน้ำ «มืด» หอคอยผุ ถนนว่าง มีเงาคนเดินกอดตัวเอง\nเงยหน้าขึ้น — เมืองจริงสว่างจ้า ทุกคนยิ้ม\n\nก้มลงมองอีกครั้ง เงาของเจ้าเองในน้ำ... กำลังมองกลับมา และมันไม่ยิ้ม"
label_text = "★ เงาในน้ำ ★"
set_flag = &"saw_lake_reflection"

