position = Vector2(2600, 790)
lore_id = &"nidhogg_root"
title = "รากที่ถูกแทะ"
text = "รากอิกดราซิลลงมาถึงที่นี่ — ปลายสุดของท่อที่ดูดทุกอย่างจากข้างบน\n\nรากถูกแทะ มีรอยฟันงูเต็มไปหมด รากตรงนั้นดำ\n\nและลึกลงไปใต้ราก... มีบางสิ่งขยับ ใหญ่กว่างูตัวไหนที่เจ้าเคยเห็น มันยังไม่ตื่น\n\n(ปูทางสู่บทท้าย — «บางสิ่งใต้ราก»)"
label_text = "รากดำ"

