[node name="RunebladeWorkbench" parent="Lore" instance=ExtResource("lore")]
position = Vector2(2400, 810)
lore_id = &"rb_brokk_workbench"
title = "ชิ้นรูนไร้เสียง"
text = "บรอกก์วางชิ้นรูนข้างเครื่องมือเก่า ร่องบนโลหะสิ้นสุดกลางทาง คล้ายแบบร่างค้อนที่ขาดวงจรส่วนหนึ่ง\n\nบันทึกข้างทั่งเขียนไว้ว่า: รับพลังได้แล้ว แต่ทางคืนพลังอยู่ที่ใด? ญอร์ดาแห่งวานาเฮมอาจจำอักษรนี้ได้\n\nหากเจ้ายังเดินในวิถีนักดาบ ลองถามบรอกก์ถึงสิ่งที่ค้อนมิได้สอน"
required_flag = &"chapter2_done"
locked_text = "บรอกก์ยังเทียบรอยรูนไม่เสร็จ ต้องค้นความจริงจากแบบร่างในเตาหลอมร้างก่อน"
label_text = "โต๊ะศึกษารูน"

