[node name="Thjazi" parent="NPCs" instance=ExtResource("npc")]
position = Vector2(330, 820)
npc_name = "ทหารยามธยาซี"
type = 0
dialog = "ไป ไปคุยกับผู้อาวุโสสกาดี ท่านบอกให้ปล่อยเจ้าเข้ามา ข้าไม่เห็นด้วย\n\nมนุษย์คนสุดท้ายที่เดินเข้าประตูนี้ เดินออกไปพร้อมกองทัพ"
greeting = "มนุษย์... ข้าได้กลิ่นค้อนตั้งแต่เจ้าอยู่ที่ช่องเขา"
voice_id = "thjazi"
quest_ids = Array[StringName]([&"c4_5_wall_they_call_ours", &"c4_8_shieldbearer"])
dialog_by_flag = {
"utgard_intro": "ผู้อาวุโสให้ตราเจ้าแล้วสินะ... ก็ได้ เดินในเมืองได้ แต่อย่าเข้าใกล้เด็ก",
"walked_with_mammoths": "เลฟบอกว่าเจ้าเดินผ่านฝูงแมมมอธโดยไม่ชักดาบ... มนุษย์แบบนั้นมีอยู่จริงหรือ",
"saw_invasion_mural": "เจ้าเห็นภาพวาดแล้ว ข้าไม่ต้องพูดอะไรอีก\n\n...ขอโทษเรื่องวันแรก",
"chapter4_done": "ธยาซี ทหารยามแห่งอุทการ์ด ยืนตรงต่อหน้าเจ้า มนุษย์\n\nถ้าเจ้ากลับมาพร้อมกองทัพ ข้าจะยืนขวาง ถ้าเจ้ากลับมาคนเดียว ประตูนี้เปิดเสมอ"
}


[node name="Skadi" parent="NPCs" instance=ExtResource("npc")]
position = Vector2(650, 820)
npc_name = "ผู้อาวุโสสกาดี"
type = 0
dialog = "ที่นี่คืออุทการ์ด นครแห่งยักษ์ — ที่ที่มนุษย์เรียกว่า «รังของสัตว์ประหลาด»\n\nมองไปรอบ ๆ สิ มีตลาด มีเด็ก มีคนแก่ มีหลุมศพ\nสัตว์ประหลาดไม่ฝังศพกัน มนุษย์"
greeting = "ข้าไม่ต้องเห็นเจ้า ข้าได้กลิ่นค้อน... และกลิ่นของคนที่เริ่มสงสัยมัน"
voice_id = "skadi"
quest_ids = Array[StringName]([&"c4_1_gate_of_giants", &"c4_4_child_who_asks", &"c4_9_breach_on_the_south", &"c4_10_heart_of_lightning"])
dialog_by_flag = {
"saw_invasion_mural": "เจ้าเห็นภาพวาดแล้ว... ข้าตาบอดมาตั้งแต่เด็ก แต่ข้าจำภาพนั้นได้ทุกเส้น\n\nนักบวชของเจ้าว่ายังไง ยักษ์วาดโกหกหรือ",
"chapter4_done": "เจ้าเอาหัวใจไปแล้ว หรือทุบมันทิ้ง ข้าไม่ถาม\n\nไปทางเหนือ อัลฟ์เฮมอยู่ตรงที่รากอิกดราซิลโผล่จากหลุม... ที่นั่นสว่างมาก ระวังตา — และระวังสิ่งที่แสงไม่ยอมให้เห็น"
}


[node name="Hymir" parent="NPCs" instance=ExtResource("npc")]
position = Vector2(1150, 820)
npc_name = "พ่อค้าฮือเมียร์"
type = 1
dialog = "ข้าขายของขนาดยักษ์ ตัดให้พอดีตัวเจ้าได้ ค่าแรงไม่คิด\n\nแค่อย่าบอกวิหารว่าซื้อมาจากยักษ์ พวกนั้นเผาร้านข้ามาแล้วสองรอบ"
shop_items = Array[StringName]([&"red_potion", &"orange_potion", &"white_potion", &"blue_potion", &"meat", &"phracon", &"emveretarcon", &"frost_edge", &"troll_cleaver", &"wall_greatsword", &"wall_shield", &"jotun_helm", &"frost_wolf_coat", &"mammoth_wool_cloak", &"troll_boots", &"echo_ring", &"root_sword", &"marsh_cutter", &"bark_armor", &"mist_cloak"])
greeting = "ของพวกเจ้าเล็กจนข้าคิดราคาไม่ถูก เอาเถอะ ถูก ๆ ไปเลย"
voice_id = "hymir"
quest_ids = Array[StringName]([&"c4_2_wolves_at_the_pass"])


[node name="Bestla" parent="NPCs" instance=ExtResource("npc")]
position = Vector2(1820, 820)
npc_name = "หมอเบสต์ลา"
type = 3
dialog = "เด็กยักษ์ตัวเท่าเจ้าคือเด็กอายุสองขวบ ข้ารักษามาเยอะ\n\nพวกเขาป่วยเพราะความหนาว ไม่ใช่เพราะสายฟ้า... ยังไม่ใช่"
heal_price = 1500
greeting = "หมอยักษ์รักษามนุษย์ได้ ยาแค่ต้องแบ่งสิบ"
voice_id = "bestla"


[node name="Gerd" parent="NPCs" instance=ExtResource("npc")]
position = Vector2(2450, 820)
npc_name = "ช่างสลักรูนเกอร์ด"
type = 2
dialog = "รูนเป็นของยักษ์มาก่อน มนุษย์ ธอร์เอามันไปทำอาวุธ\n\nวงจรเก้าดวง — พวกเจ้าอ่านออกสามดวง ข้าสลักได้เจ็ด\nดวงที่แปดกับเก้า... ไม่มีใครในโลกที่ยังมีชีวิตอ่านออก"
has_socket = true
has_refine = true
greeting = "รูนที่เจ้าถือ... ตาของข้าสลักดวงที่สี่"
voice_id = "gerd"
quest_ids = Array[StringName]([&"c4_6_fourth_rune", &"rb8_carvers_eye", &"rb9_wall_that_held_the_sky"])
dialog_by_flag = {
"rb_rune_5": "ห้าดวงแล้ว «กำเนิด» กับ «กำแพง» — ดวงต่อไปอยู่ในแสง ข้าสลักไม่ได้ ตาข้าไม่เห็นแสง\n\nไปหาคนที่ตาบอดเพราะแสง"
}


[node name="Asmund" parent="NPCs" instance=ExtResource("npc")]
position = Vector2(3200, 820)
npc_name = "นักบวชอาสมุนด์"
type = 0
dialog = "วิหารส่งข้ามาดูว่าเจ้าจะพูดกับยักษ์ยังไง ข้าไม่ปิดบัง\n\nพวกเขาเขียนประวัติศาสตร์ฝั่งตัวเองเหมือนกัน ทุกคนทำ\nเจ้าเชื่อภาพวาดของศัตรูง่ายกว่าคำสอนที่เลี้ยงเจ้ามาหรือ"
greeting = "ข้าตามเจ้ามาจากวิหาร... ที่นี่หนาวกว่าที่คิด และเงียบกว่าที่กลัว"
voice_id = "asmund"
quest_ids = Array[StringName]([&"c4_3_what_the_temple_teaches", &"c4_7_hall_of_ice"])
hide_if_flag = &"asmund_left"
dialog_by_flag = {
"saw_invasion_mural": "ข้าเห็นภาพวาดแล้ว... ข้าเห็น\n\nอย่าถามข้าตอนนี้ ข้าต้องกลับไปถามวิหาร",
"trust_asmund": "เจ้ายังเชื่อข้า... ขอบใจ ข้าจะพยายามคู่ควรกับมัน\n\nแต่ข้าจะกลับไปถามวิหารอยู่ดี — ถ้าคำตอบไม่ดี เจ้าจะได้เจอข้าอีกที่แอสการ์ด",
"doubt_asmund": "เจ้าสงสัยข้า... ก็สมควร ข้าก็สงสัยตัวเอง\n\nข้าจะกลับวิหาร รายงานสิ่งที่เห็น — ทั้งหมด รวมทั้งเรื่องเจ้า"
}


[node name="SavePoint" parent="NPCs" instance=ExtResource("npc")]
position = Vector2(2850, 820)
npc_name = "ศิลาแห่งโยตุน"
type = 4
dialog = "ศิลารูนของยักษ์ · ★ ไม่มีตราค้อนสลักทับ ★ รูนบนศิลาเหมือนรูนที่อยู่ใต้ตราค้อนในมิดการ์ด · เลือกปลายทางแล้วก้าวเข้าไปได้เลย"
warp_targets = Array[StringName]([&"prontera_town", &"nidavellir_town", &"vanir_town", &"ljosalf_city", &"eljudnir"])


[node name="Leif_kid" parent="NPCs" instance=ExtResource("npc")]
position = Vector2(3550, 820)
npc_name = "เด็กยักษ์เลฟ"
type = 0
dialog = "พี่ตัวเล็กจัง เล็กกว่าเลฟอีก\n\nที่วิหารของพี่เขาสอนว่ายักษ์กินเด็กใช่ไหม แม่ก็สอนเลฟว่ามนุษย์กินเด็ก\nแล้วใครกินจริง"
greeting = "แม่บอกว่ามนุษย์กินเด็ก... พี่กินเด็กจริงเหรอ"
voice_id = "leif"
dialog_by_flag = {
"killed_mammoth_many": "...พี่ฆ่าแมมมอธ เลฟเห็น\n\nพวกมันไม่เคยทำร้ายใคร เลฟไม่คุยกับพี่แล้ว",
"walked_with_mammoths": "พี่เดินผ่านฝูงแมมมอธโดยไม่ชักดาบ! ตัวแม่ยังดมหัวพี่เลย\n\nเลฟถักผ้าพันคอให้ ใหญ่ไปหน่อยแต่อุ่นนะ",
"chapter4_done": "พี่จะไปแล้วเหรอ... เลฟเห็นพี่ที่หลุมหัวใจ เลฟยืนดูอยู่ไกล ๆ\n\nถ้ามนุษย์เป็นเหมือนพี่ทุกคน... เลฟจะบอกแม่ว่าตำราผิด"
}


