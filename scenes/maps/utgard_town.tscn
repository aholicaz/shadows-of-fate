[node name="GiantGraves" parent="Lore" instance=ExtResource("lore")]
position = Vector2(3900, 790)
lore_id = &"giant_graves"
title = "สุสานยักษ์"
text = "หลุมศพยักษ์เรียงเป็นแถวยาว แต่ละหลุมใหญ่เท่าบ้าน ชื่อสลักด้วยรูน\n\nมีหลุมหนึ่ง... ชื่อถูกสกัดออก รอยสกัดเหมือนกับหลุมของซินดริในนิดาเวลลีร์ และศิลาในมิดการ์ด\n\nใครก็ตามที่ลบชื่อ เดินทางมาไกลถึงที่นี่"
label_text = "สุสาน"

