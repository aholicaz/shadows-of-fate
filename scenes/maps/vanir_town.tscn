[node name="Eskil" parent="NPCs" unique_id=1781619277 instance=ExtResource("npc")]
position = Vector2(1100, 820)
npc_name = "นักบันทึกเอสกิล"
type = 0
dialog = "ข้าเอสกิล นักบันทึกแห่งวิหาร ถูกส่งมาเขียนพงศาวดารวานาเฮมฉบับสมบูรณ์

ประวัติศาสตร์ต้องมีฉบับเดียว ลูกเอ๋ย... ไม่งั้นผู้คนจะสับสน"
dialog_by_flag = {
"recorded_aesir_version": "ดีมาก ประวัติศาสตร์ฉบับนี้จะสงบและเป็นระเบียบ

จงขอบคุณธอร์ที่เจ้าเลือกถูก",
"recorded_truth": "...เจ้าเขียนสิ่งที่ไม่มีใครอยากอ่านลงในสมุดของข้า

ข้าจะส่งมันไปวิหารตามหน้าที่ แต่จะไม่มีใครได้อ่านมันหรอก

จงขอบคุณธอร์... ที่ยังปล่อยให้เจ้าพูด"
}
greeting = "ผู้จาริกจากมิดการ์ด จงขอบคุณธอร์ที่นำเจ้ามาไกลถึงนี่"
