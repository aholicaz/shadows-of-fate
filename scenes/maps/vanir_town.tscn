[node name="Njorda" parent="NPCs" unique_id=636926805 instance=ExtResource("npc")]
position = Vector2(380, 820)
npc_name = "ผู้อาวุโสญอร์ดา"
type = 0
dialog = "ที่นี่คือวานาเฮม นครแห่งราก

เมื่อก่อนน้ำในบ่อกลางเมืองล้นจนไหลออกไปเลี้ยงทั้งโลก
ตอนนี้เหลือแค่ก้นบ่อ... และไม่มีใครถามว่าทำไม"
dialog_by_flag = {
"chapter3_done": "เจ้าเห็นแล้วว่าใต้บ่อน้ำมีอะไร

สงครามครั้งนั้นไม่ได้จบ... มันแค่เปลี่ยนจากดาบเป็นรูน

ไปเถอะ ทางเหนือยังมีคนที่ต้องรู้เรื่องนี้",
"saw_dry_spring": "น้ำไม่ได้แห้งเอง เจ้าก็เห็นแล้ว

มันถูก «ดึง» ขึ้นไป... ไปทางที่ต้นไม้ยักษ์ยืนอยู่"
}
greeting = "แขกจากใต้ภูเขา... นั่งก่อน รากไม่รีบ"
voice_id = "njorda"
quest_ids = Array[StringName]([&"c3_1_open_gate", &"c3_4_song_of_child", &"c3_6_withering", &"c3_10_flame_that_never_dies"])

